FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     pimpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         20;

deltaT          0.005;

writeControl    runTime;

writeInterval   1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

adjustTimeStep  no;

maxCo           1;

functions
{
    forces
    {
        type            forces;
        libs            ( forces );
        writeControl    timeStep;
        writeInterval   10;
        patches         ( innerWall );
        rho             rhoInf;
        rhoInf          900;
        CofR            ( 0 0 0 );
        writeFields     no;
    }
    torqueOuter
    {
        type            forces;
        libs            ( forces );
        writeControl    timeStep;
        writeInterval   10;
        patches         ( outerWall );
        rho             rhoInf;
        rhoInf          900;
        CofR            ( 0 0 0 );
        writeFields     no;
    }
    minMaxU
    {
        type            fieldMinMax;
        libs            ( fieldFunctionObjects );
        writeControl    timeStep;
        writeInterval   100;
        fields          ( U );
    }
}


