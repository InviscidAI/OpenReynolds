\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pimpleFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         290;

deltaT          0.01;
adjustTimeStep  no;
maxCo           1;

writeControl    runTime;
writeInterval   5;
purgeWrite      0;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable true;

functions
{
    forceCoeffs
    {
        type            forceCoeffs;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   5;
        patch           cylinder;
        patches         (cylinder);
        rho             rhoInf;
        rhoInf          1000.0;
        CofR            (0 0 0);
        liftDir         (0 1 0);
        dragDir         (1 0 0);
        pitchAxis       (0 0 1);
        magUInf         0.01;
        lRef            0.01;
        Aref            0.0001;
    }
    probes
    {
        type            probes;
        libs            (sampling);
        writeControl    timeStep;
        writeInterval   5;
        fields          (U);
        probeLocations
        (
            (0.03 0 0.005)
            (0.10 0 0.005)
        );
    }
    bodyState
    {
        type            sixDoFRigidBodyState;
        libs            (sixDoFRigidBodyState);
        writeControl    timeStep;
        writeInterval   5;
        angleFormat     degrees;
    }
}

