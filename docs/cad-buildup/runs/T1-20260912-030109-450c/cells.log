# -- cell 2 (0.1s, exit 0)
import numpy as np

# vertices (x,y) at z=0, index 0..7
V2 = [
    (-L, -R_out),  # 0 P1
    (-L, -R_in ),  # 1 P2
    (0.0,-R_in ),  # 2 B
    (0.0,-R_out),  # 3 A
    (0.0, R_in ),  # 4 C
    (0.0, R_out),  # 5 D
    (-L,  R_out),  # 6 P7
    (-L,  R_in ),  # 7 P8
]
verts = []
for (x,y) in V2:
    verts.append((x,y,0.0))
for (x,y) in V2:
    verts.append((x,y,t))
verts = np.array(verts)
print(verts.shape)

# candidate blocks using bottom-face index quadruple (z=0 indices), each will pair with +8 for top
blocks = {
    "leg1": [0,1,2,3],   # P1,P2,B,A
    "bend": [3,2,4,5],   # A,B,C,D
    "leg2": [5,4,7,6],   # D,C,P8,P7
}

def signed_area(idx):
    pts = verts[idx][:, :2]
    x = pts[:,0]; y = pts[:,1]
    return 0.5*np.sum(x*np.roll(y,-1) - np.roll(x,-1)*y)

for name, idx in blocks.items():
    print(name, idx, "area=", signed_area(idx))
