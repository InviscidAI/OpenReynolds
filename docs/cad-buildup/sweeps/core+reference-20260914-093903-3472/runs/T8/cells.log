import pyvista as pv
pv.start_xvfb() if False else None
pv.global_theme.background='white'
f = pv.OpenFOAMReader('case.foam') if os.path.exists('case.foam') else None
open('case.foam','w').close()
def render(fn):
    p = pv.Plotter(off_screen=True, window_size=(1100,600))
    for reg,col in (('fluid','lightblue'),('solid','darkorange')):
        m = pv.POpenFOAMReader('case.foam'); m.case_type='reconstructed'
        b = pv.read_meshio if False else None
    # simpler: read polyMesh via foamToVTK
    subprocess.run(['foamToVTK','-region','fluid','-ascii','-no-boundary'],capture_output=True,text=True)
    subprocess.run(['foamToVTK','-region','solid','-ascii','-no-boundary'],capture_output=True,text=True)
    fl = pv.read(sorted(__import__('glob').glob('VTK/**/fluid_0.vtk',recursive=True))[0])
    so = pv.read(sorted(__import__('glob').glob('VTK/**/solid_0.vtk',recursive=True))[0])
    p.add_mesh(fl, color='lightblue', show_edges=True, opacity=0.35)
    p.add_mesh(so, color='darkorange', show_edges=True)
    p.camera_position=[(0.35,-0.3,0.22),(0.1,0.015,0.005),(0,0,1)]
    p.screenshot(fn); return fn
print(render('coarse.png'))
print(__import__('glob').glob('VTK/**/*.vtk',recursive=True))
