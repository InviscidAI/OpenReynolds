import build123d as bd, numpy as np
from build123d import Vector

def wrap(zs, ts, r):
    th = np.asarray(ts)/r
    return [Vector(r*np.cos(a), r*np.sin(a), z) for a, z in zip(th, np.asarray(zs))]

R_B0, R_B1 = R_HUB-0.001, R_TIP+0.001      # blade extends past hub/shroud for clean cuts
NSEC = 9
radii_b = np.linspace(R_B0, R_B1, NSEC)

def blade_wire(r):
    up, lo, cam = section(r)
    e_suc = bd.Spline(*wrap(up[0], up[1], r))            # LE -> TE, suction (upper) side
    e_pre = bd.Spline(*wrap(lo[0][::-1], lo[1][::-1], r))# TE -> LE, pressure (lower) side
    return bd.Wire([e_suc, e_pre])

blade = bd.Solid.make_loft([blade_wire(r) for r in radii_b])
print("blade is_valid", blade.is_valid(), "vol[mm^3]", blade.volume*1e9, "nfaces", len(blade.faces()))
for f in blade.faces():
    print("  face area[mm2]", round(f.area*1e6,2), "center", [round(c*1e3,2) for c in f.center()])
