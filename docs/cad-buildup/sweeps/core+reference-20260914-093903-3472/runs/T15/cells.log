def cone_at(apex_z, gamma, H):
    """solid cone, apex on the axis at z=apex_z, opening toward -z, half angle 90-gamma"""
    R = H*math.tan(math.pi/2 - gamma)
    return bd.Pos(0, 0, apex_z - H)*bd.Cone(R, 0, H, align=(bd.Align.CENTER,)*2+(bd.Align.MIN,))

def bevel_gear(N, gamma, hubL, shaftEnd):
    pts, g = gear_profile(N, gamma)
    r0, rr, zo = g['r0'], g['rr'], g['zo']
    Ai = A0 - FW
    zi, ri = Ai*math.cos(gamma), Ai*math.sin(gamma)
    s = zi/zo
    zb, zf = zo + r0*math.tan(gamma), zi + ri*math.tan(gamma)   # back / front cone apexes
    wo = mkwire([(x, y, zo) for x, y in pts])
    wi = mkwire([(x*s, y*s, zi) for x, y in pts])
    band = bd.Part(bd.Solid.make_loft([wo, wi], ruled=True).wrapped)
    band = band & cone_at(zb, gamma, zb - zi + 10) - cone_at(zf, gamma, zf + 10)
    core = bd.Pos(0, 0, zi)*bd.Cone(rr*s, rr, zo - zi, align=(bd.Align.CENTER,)*2+(bd.Align.MIN,))
    hub  = bd.Pos(0, 0, zo)*bd.Cylinder(rr, hubL, align=(bd.Align.CENTER,)*2+(bd.Align.MIN,))
    shaft= bd.Pos(0, 0, zi)*bd.Cylinder(SHR, shaftEnd - zi, align=(bd.Align.CENTER,)*2+(bd.Align.MIN,))
    return (band + core + hub + shaft), dict(g, zi=zi, zb=zb, zf=zf)

