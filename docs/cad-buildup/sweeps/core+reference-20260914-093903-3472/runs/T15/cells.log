def gear_solid(N, gamma, hubL, shaftR, shaftEnd):
    pts, g = gear_profile(N, gamma)
    zo, zi = g['zo'], (A0-FW)*math.cos(gamma)
    s = zi/zo
    wo = mkwire([(x, y, zo) for x, y in pts])
    wi = mkwire([(x*s, y*s, zi) for x, y in pts])
    teeth = bd.Solid.make_loft([wo, wi], ruled=True)
    hub   = bd.Pos(0, 0, zo)*bd.Cylinder(g['rr'], hubL, align=(bd.Align.CENTER,)*2+(bd.Align.MIN,))
    shaft = bd.Pos(0, 0, zi)*bd.Cylinder(shaftR, shaftEnd-zi, align=(bd.Align.CENTER,)*2+(bd.Align.MIN,))
    return (bd.Part(teeth.wrapped) + hub + shaft), g

