pinion = bd.Rotation(0, 90, 0) * pinL       # local +z -> global +x ; a tooth centred on +z
wheel  = bd.Rotation(0, 0, 6.0) * whlL     # half-pitch turn -> a tooth space centred on +x

def inside(solid, p, tol=1e-7):
    cl = BRepClass3d_SolidClassifier(solid.wrapped, gp_Pnt(*p), tol)
    from OCP.TopAbs import TopAbs_State
    return cl.State() != TopAbs_State.TopAbs_OUT

def gap_along_pitchline(A):
    P = np.array([A*math.cos(gp), 0.0, A*math.sin(gp)])
    ys = np.linspace(0, 4, 4001)
    pin_in = np.array([inside(pinion, P + [0, y, 0]) for y in ys])
    whl_in = np.array([inside(wheel,  P + [0, y, 0]) for y in ys])
    a = ys[pin_in].max(); b = ys[whl_in].min()
    return a, b, 2*(b-a)

for A in (54.0, 50.0, 45.0, 37.0):
    a, b, bl = gap_along_pitchline(A)
    print(f"A={A:5.1f}  pinion flank y={a:.4f}  wheel flank y={b:.4f}  backlash={bl:.4f} mm  (expect {0.3*A/A0:.4f})")
