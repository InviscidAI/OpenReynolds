# -- cell 2 (1.0s, exit 1)
FW = 18.0          # face width, mm  -- CHOSEN (A0/3, standard practice)
ha, hf = 1.0*m, 1.25*m      # addendum, dedendum (perpendicular to pitch cone)

def gear_profile(N, gamma, nfl=9):
    """planar closed profile (mm) in the outer-end plane z=zo of a straight bevel gear."""
    r0 = m*N/2.0
    zo = A0*math.cos(gamma)
    rb = r0*math.cos(alpha)
    # tip / root points projected from the apex onto the plane z = zo
    rt = (r0 + ha*math.cos(gamma))*zo/(zo - ha*math.sin(gamma))
    rr = (r0 - hf*math.cos(gamma))*zo/(zo + hf*math.sin(gamma))
    phi = lambda r: math.tan(math.acos(rb/r)) - math.acos(rb/r)
    ht = (math.pi*m/2 - B/2)/2.0/r0          # half tooth-thickness angle at pitch circle
    th = lambda r: ht + phi(r0) - phi(r)
    rs = np.linspace(max(rb, rr), rt, nfl)
    fl = [(r, th(r)) for r in rs]
    if rr < rb: fl = [(rr, th(rb))] + fl
    pts = []
    for k in range(N):
        c = 2*math.pi*k/N
        seq = [(r, c - t) for r, t in reversed(fl)] + [(r, c + t) for r, t in fl]
        pts += [(r*math.cos(a), r*math.sin(a)) for r, a in seq]
    return np.array(pts), dict(r0=r0, rb=rb, rt=rt, rr=rr, zo=zo, ht=ht)

def gear_solid(N, gamma, hubL, shaftR, shaftEnd):
    pts, g = gear_profile(N, gamma)
    zo, zi = g['zo'], (A0-FW)*math.cos(gamma)
    s = zi/zo
    wo = bd.Polyline(*[(x, y, zo) for x, y in pts], close=True)
    wi = bd.Polyline(*[(x*s, y*s, zi) for x, y in pts], close=True)
    teeth = bd.loft([wo, wi], ruled=True)
    hub   = bd.Pos(0, 0, zo)*bd.Cylinder(g['rr'], hubL, align=(bd.Align.CENTER,)*2+(bd.Align.MIN,))
    shaft = bd.Pos(0, 0, zi)*bd.Cylinder(shaftR, shaftEnd-zi, align=(bd.Align.CENTER,)*2+(bd.Align.MIN,))
    return (teeth + hub + shaft), g

SHR, BORER, BOREL = 10.0, 15.0, 10.0   # CHOSEN: shaft radius, bore radius, bore length
pin_local, gpin = gear_solid(Np, gp, 12.0, SHR, LX/2 + BOREL + 15)
print("pinion volume", round(pin_local.volume,1), "bbox", pin_local.bounding_box())
print({k: round(v,4) for k,v in gpin.items()})
