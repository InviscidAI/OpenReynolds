      [round((zs[i+2]-zs[i])*1000,2) for i in range(0,len(zs)-2,2)][:5])
print("thickness (mm):", [round((zs[i+1]-zs[i])*1000,2) for i in range(0,len(zs)-1,2)][:5])
# angle of each top face
