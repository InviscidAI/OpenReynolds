horiz=[]
for f in groups["treads"]:
    if f.geom_type==bd.GeomType.PLANE and abs(f.normal_at(f.center()).Z)>0.999:
        v=np.array([[p.X,p.Y,p.Z] for p in f.vertices()]); horiz.append((f,v))
# pair up by z: tops and bottoms
