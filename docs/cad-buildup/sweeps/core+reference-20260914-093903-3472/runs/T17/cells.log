    c = f.center()
    side = "L" if c.Y > 0 else "R"
    idx = XS.index(min(XS, key=lambda x: abs(x-c.X))) + 1
    groups[f"port_{side}{idx}"] = [f]
print([(k,len(v)) for k,v in groups.items()])
print(sum(len(v) for v in groups.values()), len(F))
