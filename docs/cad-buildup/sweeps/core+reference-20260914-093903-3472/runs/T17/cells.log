F = solid.faces()
groups = OrderedDict()
groups["inlet"] = [F[15]]
groups["plenumWalls"] = [F[i] for i in (0,1,2,3,4,5,6)]
groups["runnerWalls"] = [F[i] for i in list(range(7,15))+list(range(16,24))]
