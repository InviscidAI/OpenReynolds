from build123d import *

C_ROOT, C_TIP, SPAN, STUB = 0.120, 0.080, 0.200, 0.010

def section(chord, y):
    pts = list(zip(xu, yu))[::-1] + list(zip(xl, yl))[1:]
    p3 = [(px*chord, y, pz*chord) for px, pz in pts]
    return make_face(Polyline(*p3, close=True))

root_f, tip_f = section(C_ROOT, 0.0), section(C_TIP, SPAN)
wing = loft([root_f, tip_f]) + extrude(section(C_ROOT, 0.0), amount=STUB, dir=(0,-1,0))
print("solid:", wing.is_valid(), "vol =", wing.volume, "bbox =", wing.bounding_box())
