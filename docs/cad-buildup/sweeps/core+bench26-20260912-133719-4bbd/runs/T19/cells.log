from build123d import *
import math
def face_info(f):
    s = f.geom_type
    c = f.center()
    n = f.normal_at(c) if s == GeomType.PLANE else None
    return s, (c.X, c.Y, c.Z), f.area, n
for i, f in enumerate(fluid.faces()):
    s, c, a, n = face_info(f)
    print(i, s, "area=%.6e"%a, "c=(%.5f,%.5f,%.5f)"%c, "n=", n)
