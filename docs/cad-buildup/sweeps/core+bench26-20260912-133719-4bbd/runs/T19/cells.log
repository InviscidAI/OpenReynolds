import gmsh, math, numpy as np
NZ, NR, NKW, NS, NPOCK = 20, 3, 6, 10, 5     # axial, radial(gap), keyway-arc, sector-arc, pocket-depth
A1 = math.degrees(math.acos((KW_W/2)/R_SHAFT))   # angle of flank/OD corner, from +x axis
A2 = 180.0 - A1
angs = [A1] + [A2 + i*(360.0-(A2-A1))/5 for i in range(6)]   # A1, A2, ... , A1+360
gmsh.initialize(); gmsh.model.add("seal")
g = gmsh.model.geo
O = g.addPoint(0,0,0)
def pt(r,a): return g.addPoint(r*math.cos(math.radians(a)), r*math.sin(math.radians(a)), 0)
pin  = [pt(R_SHAFT,a) for a in angs]
pout = [pt(R_BORE ,a) for a in angs]
inner, outer, radial, sects = [], [], [], []
for i in range(6):
    inner.append(g.addCircleArc(pin[i],  O, pin[i+1]))
    outer.append(g.addCircleArc(pout[i], O, pout[i+1]))
for i in range(6): radial.append(g.addLine(pin[i], pout[i]))
radial.append(radial[0])
nc = [NKW] + [NS]*5
for i in range(6):
    ll = g.addCurveLoop([inner[i], radial[i+1], -outer[i], -radial[i]])
    s = g.addPlaneSurface([ll]); sects.append(s)
    for c in (inner[i], outer[i]): g.mesh.setTransfiniteCurve(c, nc[i]+1)
    for c in (radial[i], radial[i+1]): g.mesh.setTransfiniteCurve(c, NR+1)
    g.mesh.setTransfiniteSurface(s); g.mesh.setRecombine(2, s)
# pocket: floor y=R_FLOOR, flanks x=+-KW_W/2, top = inner[0] (the keyway arc, reused)
pfr = g.addPoint( KW_W/2, R_FLOOR, 0); pfl = g.addPoint(-KW_W/2, R_FLOOR, 0)
floor  = g.addLine(pfl, pfr)
flankR = g.addLine(pfr, pin[0]); flankL = g.addLine(pin[1], pfl)
llp = g.addCurveLoop([floor, flankR, -inner[0], flankL])
pock = g.addPlaneSurface([llp])
g.mesh.setTransfiniteCurve(floor, NKW+1)
for c in (flankR, flankL): g.mesh.setTransfiniteCurve(c, NPOCK+1)
g.mesh.setTransfiniteSurface(pock, cornerTags=[pfl,pfr,pin[0],pin[1]]); g.mesh.setRecombine(2, pock)
g.synchronize()
allsurf = sects + [pock]
out = g.extrude([(2,s) for s in allsurf], 0,0,L_SEAL, numElements=[NZ], recombine=True)
g.synchronize()
tops = [out[i-1][1] for i,e in enumerate(out) if e[0]==3]
print("n extruded entities:", len(out), "tops:", tops, "vols:", [e[1] for e in out if e[0]==3])
