import numpy as np, re
def read_list(path):
    txt=open(path).read()
    body=txt[txt.index("FoamFile"):]
    return body
pts_txt=read_list("constant/polyMesh/points")
nums=re.search(r"\n(\d+)\s*\(", pts_txt)
start=nums.end()-1
arr=np.fromstring(pts_txt[start:].replace("(", " ").replace(")", " ").split(";")[0], sep=" ")
P=arr[:int(nums.group(1))*3].reshape(-1,3)
print("points", P.shape)
fa=open("constant/polyMesh/faces").read()
print(fa[fa.index("FoamFile"):][:400].replace("\n"," ")[:400])
