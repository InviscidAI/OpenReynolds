# -- cell 12 (1.5s, exit 0)
import numpy as np
from build123d import *
import matplotlib.pyplot as plt

W = 0.006; L = 0.120; T = 0.003; NLOOPS = 4
ALPHA = np.deg2rad(55); LOOP_PITCH = 0.024; X0 = 0.012
L1 = 0.014; R_LOOP = 0.006; GAMMA = np.deg2rad(200)
deg = np.degrees

def sector_face(center, theta0, gamma_deg, r_in, r_out):
    c2 = (center[0], center[1], 0)
    t0, t1 = deg(theta0), deg(theta0)-abs(gamma_deg)
    AD = AngularDirection
    mk = lambda r,a0,a1,d: Edge.make_circle(r, plane=Plane(c2,(1,0,0),(0,0,1)),
        start_angle=a0, end_angle=a1, angular_direction=d)
    outer = mk(r_out, t0, t1, AD.CLOCKWISE)
    inner = mk(r_in,  t0, t1, AD.CLOCKWISE)
    pt = lambda r,th: np.array(center)+r*np.array([np.cos(np.deg2rad(th)),np.sin(np.deg2rad(th))])
    l0 = Edge.make_line(Vector(*pt(r_out,t0),0), Vector(*pt(r_in,t0),0))
    l1 = Edge.make_line(Vector(*pt(r_out,t1),0), Vector(*pt(r_in,t1),0))
    return Face(Wire([outer, l1, inner.reversed(), l0.reversed()]))

def rect_face(a, direc, length, width, pad=0.002):
    na = (direc[1], -direc[0])
    pln = Plane((a[0], a[1], 0), x_dir=na, z_dir=(0,0,1))
    cen = (direc[0]*length/2, direc[1]*length/2, 0)
    return Rectangle(width, length + 2*pad).locate(Location(pln, cen))

def loop_face(xs):
    a = np.array([xs, W/2]); d1 = np.array([np.cos(ALPHA), np.sin(ALPHA)])
    p1 = a + L1*d1
    n0 = np.array([np.sin(ALPHA), -np.cos(ALPHA)])
    center = p1 + R_LOOP*n0
    th0 = np.arctan2(p1[1]-center[1], p1[0]-center[0])
    sec = sector_face(center, deg(th0), deg(GAMMA), R_LOOP-W/2, R_LOOP+W/2)
    th1 = th0 - GAMMA
    d_end = np.array([np.cos(ALPHA-GAMMA), np.sin(ALPHA-GAMMA)])
    p_end = center + R_LOOP*np.array([np.cos(th1), np.sin(th1)])
    l2 = p_end[1]/abs(d_end[1])
    return sec + rect_face(a, d1, L1, W) + rect_face(p_end, d_end, l2, W)

loopfaces = [loop_face(X0 + k*LOOP_PITCH) for k in range(NLOOPS)]
mainface = Rectangle(L, W).locate(Location((L/2, 0, 0)))
region2d = mainface
for lf in loopfaces: region2d = region2d + lf
print("2d area (m^2):", region2d.area, " main only:", L*W)

fig, ax = plt.subplots(figsize=(16,4))
for e in region2d.edges():
    ts = np.linspace(0,1,25)
    q = np.array([(e.position_at(t).X, e.position_at(t).Y) for t in ts])
    ax.plot(q[:,0], q[:,1], 'b.-', ms=2)
ax.set_aspect('equal'); ax.grid(True)
plt.savefig('outline.png', dpi=120); plt.show()
