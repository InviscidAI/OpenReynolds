from build123d import Edge, Face, Wire, Plane, Vector, Rectangle, extrude, Location, AngularDirection
import numpy as np

deg = np.degrees
def sector_face(center, theta0, gamma_deg, r_in, r_out):
    """annular sector swept from theta0 (deg) clockwise by gamma>0, between radii"""
    c2 = (center[0], center[1], 0)
    t0, t1 = deg(theta0), deg(theta0)-abs(gamma_deg)
    mk = lambda r,a0,a1,dir_: Edge.make_circle(r, plane=Plane(c2, (1,0,0),(0,0,1)),
        start_angle=a0, end_angle=a1, angular_direction=dir_)
    AD = AngularDirection
    outer = mk(r_out, t0, t1, AD.CLOCKWISE)
    inner = mk(r_in,  t0, t1, AD.CLOCKWISE)
    def pt(r, th): return np.array(center)+r*np.array([np.cos(np.deg2rad(th)), np.sin(np.deg2rad(th))])
    e_out0 = pt(r_out, t0); e_in0 = pt(r_in, t0)
    e_out1 = pt(r_out, t1); e_in1 = pt(r_in, t1)
    l0 = Edge.make_line(Vector(*e_out0,0), Vector(*e_in0,0))
    l1 = Edge.make_line(Vector(*e_out1,0), Vector(*e_in1,0))
    return Face(Wire([outer, l1, reversed(inner) if False else inner.reversed(), l0.reversed()])) if False else \
           Face(Wire([outer, l1, inner.reversed(), l0.reversed()]))

def rect_face(a, direc, length, width, pad=0.002):
    """rectangle from a along direc (unit), width across in-plane, with pads on both ends"""
    na = np.array([direc[1], -direc[0]])  # in-plane normal
    pln = Plane((a[0], a[1], 0), x_dir=tuple(na)+ (0,), z_dir=(0,0,1))
    return Rectangle(width, length + 2*pad).locate(Location(pln, (direc[0],direc[1],0)*(length/2)))

def loop_face(xs):
    a = np.array([xs, W/2]); d1 = np.array([np.cos(ALPHA), np.sin(ALPHA)])
    p1 = a + L1*d1
    n0 = np.array([np.sin(ALPHA), -np.cos(ALPHA)])     # right normal
    center = p1 + R_LOOP*n0
    th0 = np.arctan2(p1[1]-center[1], p1[0]-center[0])
    sec = sector_face(center, deg(th0), deg(GAMMA), R_LOOP-W/2, R_LOOP+W/2)
    dl = np.deg2rad(th0)
    th1 = th0 - GAMMA
    d_end = np.array([np.cos(ALPHA-GAMMA), np.sin(ALPHA-GAMMA)])
    p_end = center + (R_LOOP)*np.array([np.cos(th1), np.sin(th1)])
    l2 = p_end[1]/abs(d_end[1])  # reach mid channel
    r1 = rect_face(a, d1, L1, W, pad=0.002)
    r2 = rect_face(p_end - d_end*0, d_end, l2, W, pad=0.002)
    return sec + r1 + r2

loopfaces = [loop_face(X0 + k*LOOP_PITCH) for k in range(NLOOPS)]
mainface = Rectangle(L, W).locate(Location((L/2, 0, 0)))
region2d = mainface
for lf in loopfaces: region2d = region2d + lf
print("2d area:", region2d.area)

# plot
import matplotlib.pyplot as plt
fig, ax = plt.subplots(figsize=(16,4))
for e in region2d.edges():
