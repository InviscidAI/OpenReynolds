gmsh.model.mesh.field.setAsBackgroundMesh(bl)
gmsh.model.mesh.generate(3)
gmsh.write("fluid.msh")
print("nodes", len(gmsh.model.mesh.getNodes()[0]),
      "elems", len(gmsh.model.mesh.getElementsByType(4)[-1]) if True else 0)
