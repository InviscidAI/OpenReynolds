def to_poly(shape, tol):
    verts, tris = shape.tessellate(tol)
    v = np.array([ (p.X,p.Y,p.Z) for p in verts ])
    f = np.hstack([np.full((len(tris),1),3), np.array(tris, dtype=np.int64)])
    return pv.PolyData(v, f)

plotter = pv.Plotter(off_screen=True)
for i, s in enumerate(shape.solids()):
    plotter.add_mesh(to_poly(s, 0.5), color=["tomato","steelblue","limegreen"][i], opacity=0.7, show_edges=True)
plotter.view_isometric()
img = plotter.screenshot()
plotter.close()
