# -- cell 8 (0.2s, exit 1)
import pyvista as pv
import numpy as np
pv.OFF_SCREEN = True

def to_poly(shape, tol):
    verts, tris = shape.tessellate(tol)
    v = np.array([ (p.x,p.y,p.z) for p in verts ])
    f = np.hstack([np.full((len(tris),1),3), np.array(tris)]).astype(np.int64)
    return pv.PolyData(v, f)

plotter = pv.Plotter(off_screen=True)
colors = ["tomato","steelblue","limegreen"]
for i, s in enumerate(shape.solids()):
    plotter.add_mesh(to_poly(s, 0.5), color=colors[i], opacity=0.7, show_edges=True)
plotter.view_isometric()
img = plotter.screenshot()
plotter.close()
import matplotlib.pyplot as plt
plt.figure(figsize=(8,7)); plt.imshow(img); plt.axis("off"); plt.show()
