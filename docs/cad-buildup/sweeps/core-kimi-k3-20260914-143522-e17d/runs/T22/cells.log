import math, os
from pathlib import Path
for d in ["system","constant","0"]: os.makedirs(d, exist_ok=True)

# background mesh box slightly larger than disc
x0,x1 = -0.175, 0.175; y0,y1=-0.175,0.175; z0,z1=-0.02,0.02
block = """FoamFile {version 2.0; format ascii; class dictionary; object blockMeshDict;}
convertToMeters 1;
vertices ( ($x0 $y0 $z0) ($x1 $y0 $z0) ($x1 $y1 $z0) ($x0 $y1 $z0)
           ($x0 $y0 $z1) ($x1 $y0 $z1) ($x1 $y1 $z1) ($x0 $y1 $z1) );
blocks ( hex (0 1 2 3 4 5 6 7) (58 58 4) simpleGrading (1 1 1) );
boundary ( minor { type patch; } );
"""
block = block.replace("$x0",str(x0)).replace("$x1",str(x1)).replace("$y0",str(y0)).replace("$y1",str(y1)).replace("$z0",str(z0)).replace("$z1",str(z1))
# FoamFile as written inline invalid; write fun dict header properly
header = "FoamFile\n{\n version 2.0;\n format ascii;\n class dictionary;\n object blockMeshDict;\n}\n// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //\n"
blockdict = header + block[block.find("convertToMeters"):]
Path("system/blockMeshDict").write_text(blockdict)

r = 0.0; # locationInMesh inside a passage: between two adjacent vanes
ang = math.radians(5); rm=0.1275
loc = (rm*math.sin(ang), rm*math.cos(ang), 0.0)

geom = "\n".join(f'{n}.stl {{ type triSurfaceMesh; name {n}; }}' for n in patches)
geomregions = "\n".join("""{n} {{ level (4 4); patchInfo {{ type wall; }} }}""".format(n=n) for n in ["vanes","friction_top","friction_bottom"])

snappy = """FoamFile
{
 version 2.0; format ascii; class dictionary; object snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
castellatedMesh true; snap true; addLayers false;

geometry
{
 $GEOM
}

castellatedMeshControls
{
 maxLocalCells 100000;
 maxGlobalCells 2000000;
 minRefinementCells 10;
 maxLoadUnbalance 0.10;
 nCellsBetweenLevels 2;
 features ();
 refinementSurfaces
 {
 $REGIONS
 }
 resolveFeatureAngle 30;
 refinementRegions { }
 locationInMesh ($LX $LY $LZ);
 allowFreeStandingZoneFaces true;
}

snapControls
{
 nSmoothPatch 3;
 tolerance 2.0;
 nSolveIter 30;
 nRelaxIter 5;
 nFeatureSnapIter 10;
 implicitFeatureSnap false;
 explicitFeatureSnap true;
 multiRegionFeatureSnap false;
}

meshQualityControls
{; maxNonOrtho 65; maxBoundarySkewness 20; maxInternalSkewness 4; maxConcave 80;
 minFlatness 0.5; minVol 1e-13; minTetQuality 1e-15; minArea -1; minTwist 0.02;
 minDeterminant 0.001; checkFaceSimpleEdges true; minLengthScale 0.0001;
 minVolRatio 0.01; maxFaceWeightRatio 0.2; maxVolWeightRatio 0.2;
 nSmoothScale 4; errorReduction 0.75; }
"""
snappy = snappy.replace("$GEOM", geom).replace("$REGIONS", geomregions)\
 .replace("$LX",str(loc[0])).replace("$LY",str(loc[1])).replace("$LZ",str(loc[2]))
# inlet/outlet should be patch type
extra = "\n".join("{n} { level (4 4); patchInfo { type patch; } }".format(n=n) for n in ["inlet","outlet"])
snappy = snappy.replace("$REGIONS", geomregions)
# simulate already replaced; fix region substitution order by re-doing:
snappy = snappy.replace("refinementSurfaces\n {\n }\n","refinementSurfaces { x; }")
snappy = snappy.replace("$REGIONS", geomregions + extra)
Path("system/snappyHexMeshDict").write_text(snappy)
print(snappy.split("refinementSurfaces")[1][:600])
