from build123d.geom import Plane, Cylinder
def classify(f):
    g = f.geometry
    if isinstance(g, Cylinder):
        r = g.radius
        return "blind_holes" if abs(r-2.0)<1e-6 else "standoffs"
    elif isinstance(g, Plane):
        c = f.center()
        n = f.normal_at()
        # planar faces
        if abs(c.z - 20.0) < 1e-6 and abs(n.z) > 0.9:
            return "open_top"
        if abs(c.y + 50.0) < 1.5:  # vent cut face lives near y=-50 plane
            return "vent"
        return "enclosure"
    return "enclosure"
for f in faces:
    patches[classify(f)].append(f)
for k,v in patches.items(): print(k, len(v))
