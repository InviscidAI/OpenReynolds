import numpy as np
f = bd.Face()
def stl_radii(path, xtol=1e-6):
    pts=[]
    with open(path) as fh:
        for line in fh:
            p=line.split()
            if p[0:1]==["vertex"]:
                pts.append(tuple(map(float,p[1:4])))
    pts=np.array(pts)
    return pts
for name, expected in [("outerCowl",(0.450,0.430,0.410)),("coreCowl",(0.280,0.310,0.250))]:
    pts=stl_radii(f"constant/triSurface/{name}.stl")
    for x, r_exp in zip([0.0,0.45,0.9], expected):
        sel = np.abs(pts[:,0]-x) < 1e-4
        r = np.hypot(pts[sel,1], pts[sel,2])
        print(name, "x=", x, "measured r ~", round(float(np.median(r)),6), " expected", r_exp)
