import numpy as np
def radii_at(x):
    sec = air.section(bd.Plane(origin=(x,0,0), x_dir=None, z_dir=None, normal=(1,0,0)) if False else bd.Plane.XZ)
for x in [0.0, 0.45, 0.9]:
    pl = bd.Plane(origin=(x,0,0), z_dir=None, x_dir=None, y_dir=None, normal=(1,0,0)) if False else bd.Plane(origin=(x,0,0), normal=(1,0,0))
    cross = air.section(pl)
    rs = [np.linalg.norm(v.point.xz if hasattr(v.point,'xz') else (v.point.Y, v.point.Z)) for f_ in cross.faces() for v in f_.vertices()]
    # radius from vertices
    rs = sorted(set(round(np.hypot(v.WrappedPoint.Y if hasattr(v,'WrappedPoint') else 0, 0), 6) for v in cross.vertices()))
    print("x=",x, "unique radii:", rs)
