    return vids[key]
def hexb(x0,x1,y0,y1,z0,z1,nx,ny,nz):
    v=(V(x0,y0,z0),V(x1,y0,z0),V(x1,y1,z0),V(x0,y1,z0),
       V(x0,y0,z1),V(x1,y0,z1),V(x1,y1,z1),V(x0,y1,z1))
    blocks.append((v,(nx,ny,nz)))
NU, NB, ZS, ZO, NY = 53, 27, 5, 10, 20
hexb(0,0.08,0,0.03,0,0.01,NU,NY,ZS)
hexb(0.08,0.12,0,0.03,0,0.01,NB,NY,ZS)
hexb(0.12,0.2,0,0.03,0,0.01,NU,NY,ZS)
hexb(0,0.08,0,0.03,0.01,0.03,NU,NY,ZO)
hexb(0.08,0.12,0,0.03,0.01,0.03,NB,NY,ZO)
hexb(0.12,0.2,0,0.03,0.01,0.03,NU,NY,ZO)
# quad face helper: two vertices consecutive share? define faces manually
def quad(a,b,c,d,same=True):\n
    return [a,b,c,d]
eps=1e-12
inlet=[]; outlet=[]; wall=[]
for (v,n) in blocks:
    a,b,c,d,e,f,g,h = v
    coords=[verts[i] for i in v]
    faces=[(a,b,c,d),(e,h,g,f),(b,f,g,c),(a,e,h,d),(d,c,g,h),(a,b,f,e)]  # z-, z+, x+, x-, y-, y+
    idx=[(v[0],v[1],v[2],v[3]),(v[4],v[7],v[6],v[5]),(v[1],v[5],v[6],v[2]),
         (v[0],v[4],v[7],v[3]),(v[3],v[2],v[6],v[7]),(v[0],v[1],v[5],v[4])]
    for face in idx:
        P=[verts[i] for i in face]
        xs_=[p[0] for p in P]; ys_=[p[1] for p in P]; zs_=[p[2] for p in P]
        if max(xs_)-min(xs_)<eps:
            x=min(xs_)
            if x==0: inlet.append(face)
            elif x==0.2: outlet.append(face)
            else: 
                # internal if aligned with region boundary 0.08/0.12
                if abs(x-0.08)<eps or abs(x-0.12)<eps:
                    pass
                else: wall.append(face)
        elif max(ys_)-min(ys_)<eps: wall.append(face)
        elif max(zs_)-min(zs_)<eps:
            z=min(zs_)
            # internal interface faces at z=0.01 adjacent on both sides handled by both blocks
            wall.append(face)
    # end per block
print("verts",len(verts),"blocks",len(blocks),"in",len(inlet),"out",len(outlet),"wall",len(wall))
