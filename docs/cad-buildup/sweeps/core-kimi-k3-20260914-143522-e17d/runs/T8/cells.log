from collections import Counter
face_defs=[((0,1,2,3),'z-'),((4,7,6,5),'z+'),((1,5,6,2),'x+'),((0,4,7,3),'x-'),((3,2,6,7),'y-'),((0,1,5,4),'y+')]
cnt=Counter(); refs={}
for (v,n) in blocks:
    for fd,k in face_defs:
        f=tuple(v[t] for t in fd)
        key=tuple(sorted(f))
        cnt[key]+=1; refs[key]=f
patches={'inlet':[], 'outlet':[], 'walls':[]}
eps=1e-9
for key,f in refs.items():
    if cnt[key]==2: continue
    P=[verts[i] for i in f]
    if max(p[0] for p in P)-min(p[0] for p in P)<eps:
        x=P[0][0]
        patches['inlet' if x==0 else 'outlet'].append(f)
    else:
        patches['walls'].append(f)
print({k:len(v) for k,v in patches.items()})
def dicttext():
    s="FoamFile { version 2.0; format ascii; class dictionary; object blockMeshDict; }\nscale 1; vertices (\n"
    s+="\n".join(f"  ({p[0]} {p[1]} {p[2]})" for p in verts)+"\n);\nblocks (\n"
    s+="\n".join(f"  hex ({' '.join(map(str,b))}) ({n[0]} {n[1]} {n[2]}) simpleGrading (1 1 1)" for b,n in blocks)+"\n);\npatches (\n"
    for name,ftype in [('inlet','patch'),('outlet','patch'),('walls','wall')]:
        if patches[name]:
            s+=f"  {name} {ftype} (\n"+"\n".join("    ("+" ".join(map(str,faces))+")" for faces in patches[name])+"\n  );\n"
    s+=");\nmergePatchPairs ();\n"
    return s
os.makedirs("system/constant", exist_ok=True)
open("system/blockMeshDict","w").write(dicttext())
import subprocess,os
r=subprocess.run(["blockMesh"],capture_output=True,text=True)
print(r.stdout[-600:]); print(r.returncode)
