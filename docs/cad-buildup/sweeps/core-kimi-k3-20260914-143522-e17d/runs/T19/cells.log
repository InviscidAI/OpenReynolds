import build123d as bd, numpy as np
BORE_D, SHAFT_D, L = 40.1, 40.0, 60.0
KW_W, KW_D = 12.0, 5.0
S = 0.001
bore = bd.Cylinder(BORE_D/2, L, align=bd.Align.MIN)
shaft = bd.Cylinder(SHAFT_D/2, L, align=bd.Align.MIN)
kw = bd.Box(KW_W, 2*KW_D, L, align=(bd.Align.CENTER, bd.Align.MIN, bd.Align.MIN))
kw = bd.Pos(0, SHAFT_D/2 - 2*KW_D + 0.1, 0) * kw
fluid = bore - shaft - kw
print("volume mm3:", fluid.volume, " faces:", len(fluid.faces()))
for f in fluid.faces():
    print(round(f.area,3), [round(v,3) for v in f.center().to_tuple()])
import pyvista as pv, matplotlib.pyplot as plt
tri = fluid.tessellate(0.02)
v = np.array(tri[0]); c = np.array(tri[1])
pl = pv.Plotter(off_screen=True)
pl.add_mesh(pv.PolyData(v, np.hstack([np.full((len(c),1),3), c])), color='tan')
pl.show(screenshot='w')
plt.imshow(pv.get_image('w')); plt.axis('off'); plt.show()
