import build123d as bd, numpy as np, os
p="constant/triSurface"; os.makedirs(p, exist_ok=True)
BORE_R, SHAFT_R, L = 20.05, 20.0, 60.0
KW_W, KW_D = 12.0, 5.0
S=0.001
bore = bd.Cylinder(BORE_R, L, align=bd.Align.MIN)
shaft = bd.Cylinder(SHAFT_R, L, align=bd.Align.MIN)
kw = bd.Box(KW_W, KW_D+2, L, align=(bd.Align.CENTER, bd.Align.MAX, bd.Align.MIN))
kw = bd.Pos(0, SHAFT_R-1, 0) * kw
fluid = (bore - shaft) - kw
faces = list(fluid.faces())
print("vol mm3:", round(fluid.volume,2), "faces:", len(faces))
for f in faces:
    c = f.center()
    print(" area %.3f centroid r=%.3f z=%.3f"%(f.area, (c[0]**2+c[1]**2)**0.5, c[2]))
solid = fluid.scaled([S]*3)
bd.export_stl(solid, "constant/triSurface/fluid_all.stl")
import subprocess, pyvista as pv, matplotlib.pyplot as plt
m = pv.read("constant/triSurface/fluid_all.stl")
pl=pv.Plotter(off_screen=True); pl.add_mesh(m, color='tan')
pl.camera_position='xy'; pl.show(screenshot='w.png')
plt.imshow(pv.get_image('w.png')); plt.axis('off'); plt.show()
