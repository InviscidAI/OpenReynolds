import build123d as bd
groups = {"bore":[], "shaft":[], "kw_floor":[], "kw_flanks":[], "inlet_HP":[], "outlet_LP":[]}
for f in fluid.faces():
    c = tuple(f.center()); r = (c[0]**2+c[1]**2)**.5
    if c[2] < 1:   groups["outlet_LP"].append(f)
    elif c[2] > 59: groups["inlet_HP"].append(f)
    elif abs(r-15.0) < 0.2: groups["kw_floor"].append(f)
    elif f.area < 310 and r < 20.5 and abs(r-20.0) > 0.2 and abs(r-20.05) > 0.25:
        groups["kw_flanks"].append(f)
    elif abs(r-20.0) < 0.2: groups["shaft"].append(f)
    else: groups["bore"].append(f)
for k,v in groups.items():
    print(k, len(v), "area %.2f mm2"%sum(f.area for f in v))
    comp = bd.Compound(children=v)
    bd.export_stl(bd.Compound(children=list(comp.children)).scaled([S]*3), f"constant/triSurface/{k}.stl")
