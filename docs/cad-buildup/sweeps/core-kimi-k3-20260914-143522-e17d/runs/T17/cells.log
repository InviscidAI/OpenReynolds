def make_tube(side):
    """Runner tube solid starting at plenum wall x=0.., extends to x=side*90.."""
    w = runner_wire()
    prof = bd.Rot(0, -90, 0) * bd.Plane(bd.Vector(0,0,0), z_dir=(1,0,0)) * bd.Circle(R_RUN)
    # simpler: face with normal +X centered origin
    prof = bd.Face.make_plane(bd.Vector(0,0,0),(1,0,0))  # wrong
    prof = bd.Pos(0,0,0) * bd.Rot(0,90,0) * bd.Circle(R_RUN)
    tube = bd.sweep(prof, path=w)
    return tube

