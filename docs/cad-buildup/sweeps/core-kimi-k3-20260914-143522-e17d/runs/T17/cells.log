# -- cell 4 (0.1s, exit 0)
def make_tube(side):
    w = runner_wire()
    prof = bd.Pos(0,0,0) * bd.Rot(0,90/side if side<0 else 90,0) * bd.Circle(R_RUN)
    tube = bd.sweep(prof, path=w)
    return tube

t = make_tube(1)
print("volume mm3:", t.volume)
bb = t.bounding_box()
print("bbox:", bb.min.to_tuple() if hasattr(bb,'min') else bb)
