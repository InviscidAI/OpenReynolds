def scale_stl(path, fctr=0.001):
    with open(path,'rb') as fh:
        head = fh.read(80); n = struct.unpack('<I', fh.read(4))[0]
        rec = fh.read()
    out = bytearray(rec)
    for i in range(n):
        off = 12*i + i*38
        for j in range(15):  # normal(3)+vertices(9)+? per record: 3 normal + 9 verts + count
            pass
    # records: 50 bytes each: 12 floats + 2 attr
    import io
    for i in range(n):
        base = i*50
        vals = list(struct.unpack_from('<12fH', rec, base)[:12])
        vals = [v*fctr for v in vals]
        struct.pack_into('<12fH', out, base, *vals, 0)
    with open(path,'wb') as fh:
        fh.write(head); fh.write(struct.pack('<I', n)); fh.write(out)

for p in glob.glob("constant/triSurface/*.stl"):
    scale_stl(p)
print(sorted(os.listdir("constant/triSurface")))
