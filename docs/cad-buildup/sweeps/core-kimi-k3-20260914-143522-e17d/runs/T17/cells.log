import os, glob, struct, math
import build123d as bd
import pyvista

faces = list(air.faces())
def assign(f):
    gt = f.geom_type
    c = tuple(f.center()); area = f.area
    if gt == bd.GeomType.PLANE and abs(area - math.pi*R_THROTTLE**2) < 500:
        return "inlet"
    if gt == bd.GeomType.CYLINDER and f.radius and abs(f.radius - R_THROTTLE) < TOL:
        return "inletWall"
    if gt == bd.GeomType.PLANE and abs(area - math.pi*R_RUN**2) < 150:
        cx, cy, cz = c
        sideways = 'R' if cx > 0 else 'L'
        yi = ys.index(min(ys, key=lambda y: abs(y-cy)))
        return f"port_{sideways}{yi+1}"
    if gt == bd.GeomType.PLANE:
        return "plenumWalls"
    return "runnerWalls"

patches = {}
for f in faces:
    patches.setdefault(assign(f), []).append(f)
assert sum(len(v) for v in patches.values()) == len(faces)
print({k: len(v) for k,v in patches.items()})
# sanity: port face planes and positions
for name in sorted(patches):
    if name.startswith("port"):
        f = patches[name][0]
        print(name, "centre", tuple(round(x,1) for x in f.center()), "| port distance from wall:", abs(f.center()[0]) - PL_W/2)

for old in glob.glob("constant/triSurface/*.stl"): os.remove(old)
os.makedirs("constant/triSurface", exist_ok=True)
for name, fl in patches.items():
    bd.export_stl(bd.Compound(children=list(fl)), f"constant/triSurface/{name}.stl", tolerance=0.05)

def scale_stl(path, fctr=0.001):
    data = open(path,'rb').read()
    n = struct.unpack_from('<I', data, 80)[0]
    b = bytearray(data)
    for i in range(n):
        base = 84 + i*50
        vals = struct.unpack_from('<12fH', data, base)
        vals = tuple(v*fctr for v in vals[:12]) + (vals[12],)
        struct.pack_into('<12fH', b, base, *vals)
    open(path,'wb').write(b)

for p in glob.glob("constant/triSurface/*.stl"): scale_stl(p)
print(sorted(os.listdir("constant/triSurface")))
