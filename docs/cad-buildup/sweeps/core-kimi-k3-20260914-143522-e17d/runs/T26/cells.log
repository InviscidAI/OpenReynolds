import os
os.makedirs("constant/triSurface", exist_ok=True)
for name, faces in groups.items():
    bd.export_stl(bd.Compound.make_compound([f for f in faces]), f"constant/triSurface/{name}.stl", angular_tolerance=0.15, linear_tolerance=0.01)
print(sorted(os.listdir("constant/triSurface")))

import pyvista as pv
p = pv.Plotter(off_screen=True)
for name in groups:
    p.add_mesh(pv.read(f"constant/triSurface/{name}.stl"), color=None, label=name, show_edges=True, opacity=0.7)
p.camera_position = [(5,-8,5),(0,0,1.5),(0,0,1)]
p.show(screenshot="view.png")
