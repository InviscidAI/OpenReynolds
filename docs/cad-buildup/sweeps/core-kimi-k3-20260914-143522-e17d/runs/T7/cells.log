import pyvista as pv, pathlib, numpy as np, matplotlib.pyplot as plt
pathlib.Path("t7.foam").write_text("")
reader = pv.OpenFOAMReader(pathlib.Path("t7.foam").as_posix())
reader.set_time_value(0)
mesh = reader.read()
blk = mesh[0]
blk["zone"] = np.zeros(blk.n_cells, dtype=int)
zid = {n: i+1 for i, n in enumerate(blk.cell_data.get("cellZoneID", []) if False)}  # fallback
# use cellTypes? simpler: recompute via box membership
c = blk.cell_centers().points
zone = np.zeros(len(c), dtype=int)
zone[(c[:,0]>0.008)&(c[:,0]<0.028)&(c[:,1]>0.02)&(c[:,1]<0.04)&(c[:,2]<0.02)] = 1
zone[(c[:,0]>0.068)&(c[:,0]<0.088)&(c[:,1]>0.02)&(c[:,1]<0.04)&(c[:,2]>0.02)] = 2
