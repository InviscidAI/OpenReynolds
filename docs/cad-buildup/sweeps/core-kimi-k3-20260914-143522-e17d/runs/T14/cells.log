import numpy as np
import build123d as bd

def naca2412_pts(chord, n=100):
    x = (1 - np.cos(np.linspace(0, np.pi, n))) / 2
    t = 0.12; m = 0.02; p = 0.4
    yt = 5*t*(0.2969*np.sqrt(x) - 0.1260*x - 0.3516*x**2 + 0.2843*x**3 - 0.1037*x**4)
    yc = np.where(x<p, m/p**2*(2*p*x - x**2), m/(1-p)**2*((1-2*p)+2*p*x - x**2))
    seq = [(float(xi), float(yu_i)) for xi, yu_i in zip(x, yu)] + \
          [(float(xi), float(yl_i)) for xi, yl_i in list(zip(x, yl))[1:-1]]
    return seq

CR, CT, SPAN = 0.120, 0.080, 0.200

def sec_wire(chord, yspan):
    pts = [bd.Vector(x*1, yspan, th) for x, th in naca2412_pts(1.0)]
    # scale x and th by chord
    pts = [bd.Vector(v.X*chord, yspan, v.Y*chord) if False else bd.Vector(v.X*chord, yspan, v.Z*chord) for v in naca2412_pts(chord)]
    return bd.Wire.make_polygon(pts)

