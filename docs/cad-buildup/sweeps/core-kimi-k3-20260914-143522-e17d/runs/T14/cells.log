from build123d import Pos, Plane, loft, Box

def naca2412_sections(chord, n=100):
    x = (1 - np.cos(np.linspace(0, np.pi, n))) / 2
    t = 0.12; m = 0.02; p = 0.4
    yt = 5*t*(0.2969*np.sqrt(x) - 0.1260*x - 0.3516*x**2 + 0.2843*x**3 - 0.1037*x**4)
    yc = np.where(x<p, m/p**2*(2*p*x - x**2), m/(1-p)**2*((1-2*p)+2*p*x - x**2))
    return x*chord, yc-yt, yc+yt  # (x, y_lower, y_upper), z along thickness

def section_pts(points):
    x, yl, yu = points
    return [(float(xi), float(yu_i)) for xi, yu_i in zip(x, yu)] + \
           [(float(xi), float(yl_i)) for xi, yl_i in reversed(list(zip(x, yl)))][1:-1]

