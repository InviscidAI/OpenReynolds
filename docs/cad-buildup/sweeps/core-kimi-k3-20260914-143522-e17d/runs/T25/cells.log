import build123d as bd
from build123d import *
import numpy as np

# Dimensions (metres), CFM56-class turbofan
R_FAN   = 1.00
R_NAC_O = 1.15
R_HUB   = 0.32
R_SPLIT = 0.55
Z_FAN   = 0.0
Z_TE    = 2.6      # nacelle trailing edge / bypass outlet
T_DISC  = 0.06

def revolve_section(pts):
    # pts: closed polyline in (z,r) plane, revolved about Z
    l = Polyline([(z, r) for z, r in pts] + [pts[0]])
    f = make_face(l)
    return revolve(f, Axis.Z)

# Nacelle ring (closed shell section)
nacelle_pts = []
# outer profile
for z,r in [(-0.5,1.05),(-0.2,1.12),(0.6,1.15),(1.5,1.10),(2.6,0.95)]:
    nacelle_pts.append((z,r))
# inner profile back
for z,r in [(2.6,0.98),(1.5,1.05),(0.6,1.08),(-0.15,1.02),(-0.5,1.00)]:
    nacelle_pts.append((z,r))
nacelle = revolve_section(nacelle_pts)

# Hub + splitter + plug as one revolved axisymmetric body (core cowl)
core_pts = [( -0.45,0.02),(-0.30,0.20),(0.0,0.28),(0.6,0.32),(1.3,0.30),
            (1.5,0.34),(2.0,0.30),(2.6,0.12),(3.0,0.0)]
s1 = Polyline(core_pts + [(2.999,0.0),(-0.45,0.0)], close=True)
core = revolve(make_face(s1), Axis.Z)

# Splitter lip ring at z=0.3 -> separates core duct from bypass
split_pts = [(0.3,R_HUB),(0.3,R_SPLIT),(0.35,R_SPLIT+0.03),(0.45,R_SPLIT+0.03),(0.5,R_HUB+0.02)]
splitter = revolve_section(split_pts)

def disc(z, r1, r2, t=T_DISC):
    return Pos(0,0,z) * (Cylinder(r2, t) - Cylinder(r1, t+0.01))

fan   = disc(Z_FAN, R_HUB+0.02, R_FAN)
comp  = [disc(z, R_HUB+0.02, R_SPLIT+0.03) for z in (0.4,0.7,1.0)]
turb  = [disc(z, R_HUB+0.02, R_SPLIT+0.03) for z in (1.55,1.85)]
ogv   = disc(2.2, 0.28, R_FAN)

parts = {"nacelle":nacelle, "core":core, "splitter":splitter, "fan":fan,
         "compressor":Pos(0,0,0)*comp[0]+comp[1]+comp[2] if False else comp,
         "turbine":turb, "ogv":ogv}
# flatten
parts = {"nacelle":[nacelle], "core":[core], "splitter":[splitter], "fan":[fan],
         "compressor":comp, "turbine":turb, "ogv":[ogv]}

import os
os.makedirs("constant/triSurface", exist_ok=True)
import pyvista as pv
allpv=[]
for name, solids in parts.items():
    mesh=None
    for s in solids:
        bb = s.bounding_box()
        print(name, np.round([bb.min.Z,bb.max.Z,bb.max.Y],3))
        t = s.to_vtk(vtk_grid_type=None) if hasattr(s,'to_vtk') else None
        import trimesh
    from build123d import Mesher
    units = Mesher.Unit.MM
    m = Mesher(unit=units)
    m.add_shape(solids)
    m.write(f"constant/triSurface/{name}.stl")
    print(name, "written")
print("bbox ok")
