import build123d as bd
from build123d import *
import numpy as np, os

R_FAN=1.00; R_NAC_O=1.15; R_HUB=0.32; R_SPLIT=0.55; Z_FAN=0.0; Z_TE=2.6; T_DISC=0.06

def revolve_section(pts_rz):
    # pts: (r,z) closed polyline in XZ plane (r>=0), revolved about Z
    pts = [Vector(r,0,z) for r,z in pts_rz]
    l = Polyline(pts + [pts[0]])
    return revolve(make_face(l), Axis.Z)

nacelle_pts = ([(1.05,-0.5),(1.12,-0.2),(1.15,0.6),(1.10,1.5),(0.95,2.6)] +
               [(0.98,2.6),(1.05,1.5),(1.08,0.6),(1.02,-0.15),(1.00,-0.5)])
nacelle = revolve_section(nacelle_pts)

core_pts = [(0.02,-0.45),(0.20,-0.30),(0.28,0.0),(0.32,0.6),(0.30,1.3),
            (0.34,1.5),(0.30,2.0),(0.12,2.6),(0.0,3.0),(0.0,-0.45)]
core = revolve_section(core_pts)

split_pts = [(R_HUB,0.3),(R_SPLIT,0.3),(R_SPLIT+0.03,0.35),(R_SPLIT+0.03,0.45),(R_HUB+0.02,0.5)]
splitter = revolve_section(split_pts)

def disc(z, r1, r2, t=T_DISC):
    return Pos(0,0,z) * (Cylinder(r2, t) - Cylinder(r1, t+0.01))

fan   = disc(Z_FAN, R_HUB+0.02, R_FAN)
comp  = [disc(z, R_HUB+0.02, R_SPLIT+0.03) for z in (0.4,0.7,1.0)]
turb  = [disc(z, R_HUB+0.02, R_SPLIT+0.03) for z in (1.55,1.85)]
ogv   = disc(2.2, 0.28, R_FAN)

parts = {"nacelle":[nacelle], "core":[core], "splitter":[splitter], "fan":[fan],
         "compressor":comp, "turbine":turb, "ogv":[ogv]}

os.makedirs("constant/triSurface", exist_ok=True)
from build123d import Mesher
for name, solids in parts.items():
    for s in solids:
        bb = s.bounding_box()
        print(name, "z,rmax:", round(bb.min.Z,3), round(bb.max.Z,3), round(bb.max.Y,3))
    m = Mesher(unit=Mesher.Unit.M)
    m.add_shape(solids)
    m.write(f"constant/triSurface/{name}.stl")
print("STLs written")
