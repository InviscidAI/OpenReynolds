    ps=[occ.addPoint(p[0],0.0,p[1]) for p in poly]
    ls=[occ.addLine(ps[i],ps[(i+1)%len(ps)]) for i in range(len(ps))]
    return occ.addCurveLoop(ls)
cl_o=loop(T_OUT); cl_i=loop(T_IN)
f=occ.addPlaneSurface([cl_o,cl_i])
occ.synchronize()
pipe=occ.addPipe([(2,f)],[(1,wire)])
occ.synchronize()
gmsh.model.mesh.setSize(gmsh.model.getEntities(0),1.5)
