import gmsh, math, numpy as np

# ---- parameters (mm) ----
R_MAJOR = 20.0      # neck OD 40 mm
R_MINOR = 19.0      # thread depth 1 mm
PITCH = 2.0
HEIGHT = 12.0
GAP = 0.2
# trapezoid ridge profile (r, z), root halfwidth 0.7, crest halfwidth 0.45
T_IN = [(R_MINOR,-0.7),(R_MINOR,0.7),(R_MAJOR,0.45),(R_MAJOR,-0.45)]

def poly_offset(poly, d):
    n = len(poly); out=[]
    P=[np.array(p) for p in poly]
    for i in range(n):
        a,b = P[i], P[(i+1)%n]
        e = b-a; nrm = np.array([e[1],-e[0]])/np.linalg.norm(e)
        # signed offsets intersection
        pass
    # simple: shift every edge outward by d, intersect consecutive shifted edges
    shifted=[]
    for i in range(n):
        a,b = P[i], P[(i+1)%n]
        e=b-a; nrm=np.array([e[1],-e[0]]); nrm/=np.linalg.norm(nrm)
        shifted.append((a+nrm*d, b+nrm*d))
    res=[]
    for i in range(n):
        (a1,b1)=shifted[i]; (a2,b2)=shifted[(i+1)%n]
        # intersect lines
        d1=b1-a1; d2=b2-a2
        t = np.cross(a2-a1, d2)/np.cross(d1,d2)
        res.append(tuple(a1+t*d1))
    return res

T_OUT = poly_offset(T_IN, GAP)
print("T_IN:", T_IN); print("T_OUT:", T_OUT)

gmsh.initialize(); gmsh.option.setNumber("General.Terminal",0)
gmsh.model.add("gap")
occ = gmsh.model.occ

# helix wire, radius at mid-profile
Rc = (R_MAJOR+R_MINOR)/2
NTURNS = HEIGHT/PITCH
NPPT = 24  # points per turn
pts=[]
total = int(NTURNS*NPPT)
for i in range(total+1):
    th = 2*math.pi*i/NPPT*(1)
    t  = th/(2*math.pi)*PITCH  # z height
    pts.append(occ.addPoint(Rc*math.cos(th), Rc*math.sin(th), t))
wire = occ.addBSpline(pts)
occ.synchronize()
# annular trapezoid face in x-z plane at start point (Rc,0,0)
def face_from(poly):
    ps=[occ.addPoint(p[0],0,p[1]) for p in poly]
    ls=[occ.addLine(ps[i],ps[(i+1)%len(ps)]) for i in range(len(ps))]
    cl=occ.addCurveLoop(ls)
    return occ.addWire(ls), ls, occ.addPlaneSurface([occ.addCurveLoop(ls)])
# face with hole: outer minus inner
ps_o=[occ.addPoint(p[0],0,p[1]) for p in T_OUT]
ls_o=[occ.addLine(ps_o[i],ps_o[(i+1)%len(ps_o)]) for i in range(4)]
cl_o=occ.addCurveLoop(ls_o)
ps_i=[occ.addPoint(p[0],0,p[1]) for p in T_IN]
ls_i=[occ.addLine(ps_i[i],ps_i[(i+1)%len(ps_i)]) for i in range(4)]
cl_i=occ.addCurveLoop(ls_i)
f = occ.addPlaneSurface([cl_o, cl_i])
occ.synchronize()
pipe = occ.addPipe([(2,f)], [(1,wire)])
occ.synchronize()
gmsh.model.mesh.generate(3)
gmsh.write("gap_mm.stl")
vols = gmsh.model.getEntities(3); print("vols",vols)
bnd = gmsh.model.getBoundary(vols, combined=False)
print("boundary surfaces:", bnd)
for dim,tag in bnd:
    bb = gmsh.model.getBoundingBox(dim,tag)
    print(tag, [round(v,2) for v in bb])
gmsh.finalize()
