import gmsh, math, numpy as np

R_MAJOR = 20.0; R_MINOR = 19.0; PITCH = 2.0; HEIGHT = 12.0; GAP = 0.2
T_IN = [(R_MINOR,-0.7),(R_MINOR,0.7),(R_MAJOR,0.45),(R_MAJOR,-0.45)]
c2 = lambda a,b: a[0]*b[1]-a[1]*b[0]

def poly_offset(poly, d):
    n=len(poly); P=[np.array(p,float) for p in poly]
    shifted=[]
    for i in range(n):
        a,b=P[i],P[(i+1)%n]; e=b-a; nrm=np.array([e[1],-e[0]]); nrm/=np.linalg.norm(nrm)
        shifted.append((a+nrm*d, b+nrm*d))
    res=[]
    for i in range(n):
        (a1,b1)=shifted[i]; (a2,b2)=shifted[(i+1)%n]
        d1=b1-a1; d2=b2-a2
        t=c2(a2-a1,d2)/c2(d1,d2)
        res.append(tuple(a1+t*d1))
    return res

T_OUT = poly_offset(T_IN, GAP)
print("T_OUT:", [(round(a,3),round(b,3)) for a,b in T_OUT])

gmsh.initialize(); gmsh.option.setNumber("General.Terminal",0)
gmsh.model.add("gap"); occ = gmsh.model.occ
Rc=(R_MAJOR+R_MINOR)/2; NPPT=32
NTURNS=HEIGHT/PITCH; total=int(NTURNS*NPPT)
pts=[]
for i in range(total+1):
    th=2*math.pi*i/NPPT; z=th/(2*math.pi)*PITCH
    pts.append(occ.addPoint(Rc*math.cos(th), Rc*math.sin(th), z))
wire=occ.addBSpline(pts)
