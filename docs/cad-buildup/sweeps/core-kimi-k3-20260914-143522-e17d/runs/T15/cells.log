def rotZ_to_X():   # maps local +Z axis onto global +X
    return bd.Rot(0,90,0)
def rotZ_to_Y():   # local +Z onto global +Y
    return bd.Rot(-90,0,0)

pin_l = rotZ_to_X() * pinion
best=None
for ph in np.linspace(0, 2*np.pi/z2, 9):
