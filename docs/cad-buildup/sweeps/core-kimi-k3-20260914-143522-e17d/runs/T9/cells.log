import re
def read_field(path):
    txt = open(path).read()
    m = re.search(r"\n(\d+)\s*\(\s*([^)]*?)\s*\)", txt, re.S)
    return int(m.group(1)), m.group(2)
n, pts = read_field("constant/polyMesh/points")
pts = np.reshape(np.fromstring(pts, sep=" "), n)[0] if False else None
import numpy as np
vals = np.fromstring(pts, sep=" " if False else None)
# easier plain split:
arr = np.array([float(x) for x in pts.replace("(", " ").replace(")", " ").split()]).reshape(-1,3)
print("points n", n, "z range", arr[:,2].min(), arr[:,2].max())
n2, fcs = read_field("constant/polyMesh/faces")
nums = fcs.replace("("," ").replace(")"," ").split()
it = iter(nums)
faces = []
while True:
    try: k = int(next(it))
    except StopIteration: break
    faces.append([int(next(it)) for _ in range(k)])
faces = list(map(list, faces))
def patch_z(start, count):
    zs = [arr[f,2].mean() for f in faces[start:start+count]]
    return sum(zs)/len(zs)
for name,(st,ct) in {"patch1":(19167,1013),"patch2":(20180,1013)}.items():
    print(name, "mean z =", patch_z(st,ct))
