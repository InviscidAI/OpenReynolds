def blade_wires3():
    ws = []
    for r, planar in [(R_LO, True)] + [(x, False) for x in RADII] + [(R_HI, True)]:
        (su, zu), (sl, zl) = sec_sz(r)
        f = flat if planar else wrap
        pu, pl = f(r, su, zu), f(r, sl, zl)
        e_suc = Spline(*pu)                    # LE -> TE (suction / upper)
        e_te  = Line(pu[-1], pl[-1])           # trailing edge segment
        e_prs = Spline(*pl[::-1])              # TE -> LE (pressure / lower)
        ws.append(Wire([e_suc, e_te, e_prs]))
    return ws

