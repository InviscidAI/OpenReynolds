from build123d import *

TE_OPEN = 0.010            # TE closure added to half-thickness (fraction of chord), renormalised
R_LO, R_HI = 0.040, 0.095  # blade extended past hub/shroud for clean trimming
NSEC, NPT = 9, 41

def sec_sz(r, n=NPT):
    c = CHORD
    beta = np.linspace(0, np.pi, n)
    x = 0.5*c*(1-np.cos(beta))
    R = c/(2*np.sin(CAMBER/2))
    yc = np.sqrt(R**2-(x-c/2)**2) - R*np.cos(CAMBER/2)
    th = np.arctan(-(x-c/2)/np.sqrt(R**2-(x-c/2)**2))
    xi = x/c
    yt = 5*TMAX*c*(0.2969*np.sqrt(xi)-0.1260*xi-0.3516*xi**2+0.2843*xi**3-0.1036*xi**4)
    yt = yt + TE_OPEN*c*xi
    yt = yt*(TMAX*c/2)/yt.max()                      # renormalise so max thickness = 6% chord
    xu, yu = x - yt*np.sin(th), yc + yt*np.cos(th)
    xl, yl = x + yt*np.sin(th), yc - yt*np.cos(th)
    g = STAG_R + TWIST*(r-R_HUB)/(R_TIP-R_HUB)
    def to_sz(xx, yy):
        xx = xx - c/2
        return xx*np.sin(g)+yy*np.cos(g), xx*np.cos(g)-yy*np.sin(g)
    return to_sz(xu, yu), to_sz(xl, yl)

def wrap(r, s, z):
    t = s/r
    return [Vector(r*np.cos(ti), r*np.sin(ti), zi) for ti, zi in zip(t, z)]

radii = np.linspace(R_LO, R_HI, NSEC)
wires = []
for r in radii:
    (su, zu), (sl, zl) = sec_sz(r)
    pu = wrap(r, su, zu); pl = wrap(r, sl, zl)
    e_suc = Spline(*pu)                       # LE -> TE, suction/upper side
    e_prs = Spline(*pl[::-1])                 # TE -> LE, pressure/lower side
    wires.append(Wire([e_suc, e_prs]))
blade0 = loft(wires, ruled=False)
print(type(blade0), blade0.is_valid(), "vol mm^3 =", blade0.volume*1e9, " faces:", len(blade0.faces()))
bb = blade0.bounding_box(); print("bbox mm:", [round(v*1000,2) for v in (bb.min.X,bb.min.Y,bb.min.Z,bb.max.X,bb.max.Y,bb.max.Z)])
