import numpy as np, re
def read_patch(reg,pname):
    P=open(f"constant/{reg}/polyMesh/points").read(); F=open(f"constant/{reg}/polyMesh/faces").read()
    B=open(f"constant/{reg}/polyMesh/boundary").read()
    pts=np.array([list(map(float,m)) for m in re.findall(r"\(([-\d.e+ ]+)\)",P.split("(",1)[1])])
    faces=[list(map(int,m.split())) for m in re.findall(r"\d+\(([\d ]+)\)",F)]
    blk=re.search(pname+r"\s*\{(.*?)\}",B,re.S).group(1)
    n=int(re.search(r"nFaces\s+(\d+)",blk).group(1)); s=int(re.search(r"startFace\s+(\d+)",blk).group(1))
    typ=re.search(r"type\s+(\w+)",blk).group(1)
    fl=faces[s:s+n]
    area=sum(abs(np.cross(pts[f[1]]-pts[f[0]],pts[f[2]]-pts[f[0]])[2])/2*2 for f in fl)  # planar quads, z-normal
    ids=sorted({i for f in fl for i in f})
    return typ,n,area,np.array(sorted(map(tuple,np.round(pts[ids],9))))
tf,nf,af,pf=read_patch("fluid","fluid_to_solid"); ts,ns,asld,ps=read_patch("solid","solid_to_fluid")
print("fluid_to_solid type",tf,"faces",nf,"area mm^2",round(af/mm**2,3))
print("solid_to_fluid type",ts,"faces",ns,"area mm^2",round(asld/mm**2,3),"expected",40*30)
print("identical point sets:",pf.shape==ps.shape and np.allclose(pf,ps), pf.shape)
print("interface z =",sorted({round(p[2],9) for p in pf}))
