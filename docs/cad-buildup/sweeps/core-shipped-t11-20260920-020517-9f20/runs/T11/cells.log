    except Exception:
        return 0.0
for label,src in [('inlet',inlet_source),('outlet',outlet_source),('wall0',duct_wall_sources[0])]:
    vals=sorted([coincident_area(f,src) for f in fluid.faces()], reverse=True)
    print(label, vals[:5])
