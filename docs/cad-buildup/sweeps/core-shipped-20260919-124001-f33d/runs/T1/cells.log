b = final_mesh.bounds
analytic_area = 2*L*W + 0.5*np.pi*(R_OUT**2-R_IN**2)
mesh_volume = float(final_mesh.compute_cell_sizes(length=False, area=False, volume=True)["Volume"].sum())
