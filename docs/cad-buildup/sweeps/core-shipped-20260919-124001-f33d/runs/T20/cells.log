# Requested dimensions, all converted from mm to metres.
FLANGE_OD=0.180; FLANGE_T=0.020; BORE_D=0.060; GASKET_T=0.002
BOLT_D=0.014; BOLT_PCD=0.140; N_BOLTS=6
R=BORE_D/2; TOTAL_L=2*FLANGE_T+GASKET_T
# Build three cylindrical pieces only to harvest their outer faces.
segments=[bd.Cylinder(R,h,align=(bd.Align.CENTER,bd.Align.CENTER,bd.Align.MIN)).moved(bd.Location((0,0,z)))
          for z,h in [(0,FLANGE_T),(FLANGE_T,GASKET_T),(FLANGE_T+GASKET_T,FLANGE_T)]]
def lateral_face(s):
    return max(s.faces(), key=lambda f:f.area)
side_faces=[lateral_face(s) for s in segments]
inlet_face=min(segments[0].faces(),key=lambda f:f.center().Z)
outlet_face=max(segments[-1].faces(),key=lambda f:f.center().Z)
fluid_shell=bd.Shell([inlet_face,*side_faces,outlet_face])
fluid=bd.Solid(fluid_shell).fix()
# Non-meshed visual reference: two holed flanges and gasket annulus.
def ring(z,t,od):
    outer=bd.Cylinder(od/2,t,align=(bd.Align.CENTER,bd.Align.CENTER,bd.Align.MIN)).moved(bd.Location((0,0,z)))
    bore=bd.Cylinder(R,t,align=(bd.Align.CENTER,bd.Align.CENTER,bd.Align.MIN)).moved(bd.Location((0,0,z)))
    bolts=None
    for i in range(N_BOLTS):
        a=2*3.141592653589793*i/N_BOLTS; x=(BOLT_PCD/2)*__import__('math').cos(a); y=(BOLT_PCD/2)*__import__('math').sin(a)
        h=bd.Cylinder(BOLT_D/2,t,align=(bd.Align.CENTER,bd.Align.CENTER,bd.Align.MIN)).moved(bd.Location((x,y,z)))
        bolts=h if bolts is None else bolts+h
    return outer-bore-bolts
flange1=ring(0,FLANGE_T,FLANGE_OD); gasket=ring(FLANGE_T,GASKET_T,FLANGE_OD); flange2=ring(FLANGE_T+GASKET_T,FLANGE_T,FLANGE_OD)
print('fluid valid:',fluid.is_valid,'solids:',len(fluid.solids()),'faces:',len(fluid.faces()))
print('volume measured/requested m3:',fluid.volume,3.141592653589793*R**2*TOTAL_L)
print('length measured/requested m:',fluid.bounding_box().size.Z,TOTAL_L)
print('diameter measured/requested m:',fluid.bounding_box().size.X,BORE_D)
print('side areas:',[round(f.area,9) for f in side_faces])
