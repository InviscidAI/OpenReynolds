# Requested dimensions and explicit first-pass assumptions, in mm for CAD construction.
CHANNEL_W = 6.0
LENGTH = 120.0
THICKNESS = 1.0
N_LOOPS = 4
STAGE_PITCH = 24.0
LOOP_SPAN = 20.0
LOOP_RISE = 12.0
FIRST_BRANCH_X = 12.0

main_2d = bd.Pos(LENGTH/2, 0) * bd.Rectangle(LENGTH, CHANNEL_W)
x0 = FIRST_BRANCH_X
x1 = x0 + LOOP_SPAN
stage_path = bd.Wire(bd.Bezier((x0,0),(x0+4,0),(x1-5,LOOP_RISE),(x1,0)))
stage_strip = bd.offset(stage_path, amount=CHANNEL_W/2, side=bd.Side.BOTH, closed=True)
stage_2d = main_2d + stage_strip
print('main area mm2:', main_2d.area)
print('stage strip area mm2:', stage_strip.area)
print('union area mm2:', stage_2d.area)
print('union faces:', len(stage_2d.faces()), 'edges:', len(stage_2d.edges()))
print('bounds mm:', stage_2d.bounding_box().min, stage_2d.bounding_box().max)
