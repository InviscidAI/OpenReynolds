import gmsh, os, subprocess, textwrap
gmsh.initialize(); gmsh.model.add('impellerFluid')
ents=gmsh.model.occ.importShapes('fluid.step'); vols=[e for e in ents if e[0]==3]
outer=gmsh.model.occ.addCylinder(0,0,Z0,0,0,BLADE_H,R_IN)
inner=gmsh.model.occ.addCylinder(0,0,Z0,0,0,BLADE_H,R_HUB)
tool,_=gmsh.model.occ.cut([(3,outer)],[(3,inner)])
frag,_=gmsh.model.occ.fragment(vols,tool); gmsh.model.occ.synchronize()
allvol=[e for e in gmsh.model.getEntities(3)]
print('fragment volumes',allvol)
# One volume physical group causes conformal shared faces to remain internal on conversion.
gmsh.model.addPhysicalGroup(3,[t for d,t in allvol],1); gmsh.model.setPhysicalName(3,1,'fluid')
# Classify exterior boundary surfaces; ignore surfaces shared by two volumes.
usage={}
for v in allvol:
 for s in gmsh.model.getBoundary([v],oriented=False,recursive=False): usage[s[1]]=usage.get(s[1],0)+1
ext=[s for s,n in usage.items() if n==1]
pg={k:[] for k in ['inlet','radial_outlet','blades','backplate','hub','shroud']}
for s in ext:
 x0,y0,z0,x1,y1,z1=gmsh.model.getBoundingBox(2,s); dz=z1-z0
 rmax=max(math.hypot(x,y) for x in (x0,x1) for y in (y0,y1))
 rbox=max(abs(x0),abs(x1),abs(y0),abs(y1))
 if dz<1e-7 and abs(z0-Z0)<1e-6: key='backplate'
 elif dz<1e-7 and abs(z0-Z1)<1e-6: key='inlet' if rmax < R_IN*1.5 else 'shroud'
 elif rbox < R_HUB*1.2: key='hub'
 elif rbox > R_OUT*0.99: key='radial_outlet'
 else: key='blades'
 pg[key].append(s)
for i,(name,ss) in enumerate(pg.items(),11):
 print(name,len(ss)); gmsh.model.addPhysicalGroup(2,ss,i); gmsh.model.setPhysicalName(2,i,name)
gmsh.option.setNumber('Mesh.MeshSizeMin',0.0025); gmsh.option.setNumber('Mesh.MeshSizeMax',0.004)
gmsh.option.setNumber('Mesh.Algorithm3D',1); gmsh.model.mesh.generate(3); gmsh.write('impeller.msh'); gmsh.finalize()
subprocess.run(['gmshToFoam','impeller.msh'],check=True,text=True)
print('mesh converted')
