# -- cell 7 (240.0s, exit 0)
from OCP.BRepAlgoAPI import BRepAlgoAPI_Defeaturing
from OCP.BRepAdaptor import BRepAdaptor_Surface
scanner = solids[1]
blend_faces = []
for face in scanner.faces():
    ad = BRepAdaptor_Surface(face.wrapped)
    typ = str(face.geom_type)
    if typ == 'GeomType.CYLINDER' and abs(ad.Cylinder().Radius() - 0.5) < 1e-5:
        blend_faces.append(face)
    elif typ == 'GeomType.TORUS' and abs(ad.Torus().MinorRadius() - 0.5) < 1e-5:
        blend_faces.append(face)
print('Measured 0.5 mm blend faces selected:', len(blend_faces))
defeat = BRepAlgoAPI_Defeaturing()
defeat.SetShape(scanner.wrapped)
for face in blend_faces: defeat.AddFaceToRemove(face.wrapped)
defeat.Build()
print('Defeaturing done:', defeat.IsDone())
scanner_defeatured = bd.Solid(defeat.Shape())
print('Before: valid', scanner.is_valid, 'faces', len(scanner.faces()), 'volume', scanner.volume, 'bbox', scanner.bounding_box())
print('After:  valid', scanner_defeatured.is_valid, 'faces', len(scanner_defeatured.faces()), 'volume', scanner_defeatured.volume, 'bbox', scanner_defeatured.bounding_box())
