for i, face in enumerate(fluid.faces()):
    c = face.center()
    try:
        n = face.normal_at()
    except Exception:
        n = None
    print(i, "type=", face.geom_type, "area=", round(face.area,8), "center=", tuple(round(v,5) for v in c), "normal=", None if n is None else tuple(round(v,3) for v in n))
