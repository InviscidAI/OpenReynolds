# -- cell 3 (0.9s, exit 1)
import math
# Requested dimensions, all in metres
R = 0.060
H = 0.200
OUTLET_R = 0.020
PORT_W = 0.020
PORT_H = 0.030
PORT_ZC = 0.040
DUCT_L = 0.050
SWIRL_OFF_TANGENT_DEG = 15.0

vessel = bd.Cylinder(R, H, align=(bd.Align.CENTER, bd.Align.CENTER, bd.Align.MIN))
duct_solids = []
duct_axes = []
for i, theta_deg in enumerate((0.0, 90.0, 180.0, 270.0), start=1):
    phi_deg = theta_deg + 90.0 + SWIRL_OFF_TANGENT_DEG
    theta = math.radians(theta_deg)
    phi = math.radians(phi_deg)
    wall_point = (R*math.cos(theta), R*math.sin(theta), 0.0)
    duct_local = bd.Pos(-DUCT_L, -PORT_W/2, PORT_ZC-PORT_H/2) * bd.Box(
        DUCT_L + 0.100, PORT_W, PORT_H,
        align=(bd.Align.MIN, bd.Align.MIN, bd.Align.MIN))
    duct = bd.Pos(*wall_point) * bd.Rot(0, 0, phi_deg) * duct_local
    duct_solids.append(duct)
    duct_axes.append(((math.cos(phi), math.sin(phi), 0.0), wall_point))

fluid_raw = vessel
for duct in duct_solids:
    fluid_raw = fluid_raw + duct

# Replace OCC's single top disk by an outlet disk plus annular top face.
top_candidates = [f for f in fluid_raw.faces() if abs(f.center().Z-H) < 1e-9 and abs(f.normal_at().Z) > 0.99]
assert len(top_candidates) == 1, len(top_candidates)
outer_wire = bd.Wire.make_circle(R, bd.Plane((0,0,H), x_dir=(1,0,0), z_dir=(0,0,1)))
inner_wire = bd.Wire.make_circle(OUTLET_R, bd.Plane((0,0,H), x_dir=(1,0,0), z_dir=(0,0,1)))
top_annulus_created = bd.Face.make_surface(outer_wire, interior_wires=[inner_wire])
outlet_created = bd.Face.make_surface(inner_wire)
kept_faces = [f for f in fluid_raw.faces() if f is not top_candidates[0]]
fluid = bd.Solid(bd.Shell(kept_faces + [top_annulus_created, outlet_created]))
print('fluid valid:', fluid.is_valid, 'solids:', len(fluid.solids()), 'faces:', len(fluid.faces()))
print('volume [m3]:', fluid.volume)
print('extent [m]:', tuple(round(x,6) for x in (fluid.bounding_box().min.X, fluid.bounding_box().max.X, fluid.bounding_box().min.Y, fluid.bounding_box().max.Y, fluid.bounding_box().min.Z, fluid.bounding_box().max.Z)))
print('requested/measured vessel ID [mm]:', 120.0, 2*R*1000)
print('requested/measured height [mm]:', 200.0, (fluid.bounding_box().max.Z-fluid.bounding_box().min.Z)*1000)
print('requested/measured outlet diameter [mm]:', 40.0, 2*math.sqrt(outlet_created.area/math.pi)*1000)
print('requested/measured port centre z [mm]:', 40.0, PORT_ZC*1000)
print('requested/measured duct exposed axis length [mm]:', 50.0, DUCT_L*1000)
print('requested/measured off-tangent angle [deg]:', 15.0, math.degrees(math.acos(math.cos(math.radians(SWIRL_OFF_TANGENT_DEG)))))
