# Read each region mesh directly through small region marker files.
Path('fluid.foam').touch(); Path('solid.foam').touch()
def region_grid(region):
    rr=pv.OpenFOAMReader(f'{region}.foam', case_type='reconstructed')
    rr._reader.SetRegionName(region)
    mm=rr.read()
    return mm['internalMesh'] if 'internalMesh' in mm.keys() else mm[0]
fg=region_grid('fluid'); sg=region_grid('solid')
print('Final region cells:', fg.n_cells, 'fluid,', sg.n_cells, 'solid')
p=pv.Plotter(off_screen=True,window_size=(1100,430))
p.add_mesh(fg, color='#70bde3', opacity=0.25, show_edges=True, edge_color='#39779a', label='fluid')
p.add_mesh(sg, color='#b87333', show_edges=True, edge_color='black', label='solid')
p.add_legend(); p.view_isometric(); p.camera.zoom(1.25); p.add_axes()
p.show(screenshot='final_regions.png',auto_close=True)
display(Image('final_regions.png'))
