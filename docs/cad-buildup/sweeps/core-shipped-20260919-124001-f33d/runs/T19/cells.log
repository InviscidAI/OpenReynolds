# -- cell 1 (4.8s, exit 0)
import build123d as bd
import math
# All dimensions are metres.
L = 0.060
R_BORE = 0.02005
R_SHAFT = 0.020
KEY_WIDTH = 0.012
KEY_DEPTH = 0.005
# Shaft axis is Z; keyway is centred on +Y and cut down from y=R_SHAFT.
bore_volume = bd.Cylinder(R_BORE, L)
shaft_blank = bd.Cylinder(R_SHAFT, L)
keyway_cutter = bd.Pos(-KEY_WIDTH/2, R_SHAFT-KEY_DEPTH, 0) * bd.Box(KEY_WIDTH, KEY_DEPTH+0.001, L)
shaft_solid = shaft_blank - keyway_cutter
fluid = bore_volume - shaft_solid
expected_area = math.pi*(R_BORE**2-R_SHAFT**2) + KEY_WIDTH*KEY_DEPTH
expected_volume = expected_area*L
print(f'Length: measured {fluid.bounding_box().size.Z:.9f} m, requested {L:.9f} m')
print(f'Bore diameter: built {2*R_BORE:.9f} m, requested 0.040100000 m')
print(f'Shaft diameter: built {2*R_SHAFT:.9f} m, requested 0.040000000 m')
print(f'Radial clearance: built {R_BORE-R_SHAFT:.9f} m, requested 0.000050000 m')
print(f'Keyway width: built {KEY_WIDTH:.9f} m, requested 0.012000000 m')
print(f'Keyway depth: built {KEY_DEPTH:.9f} m, requested 0.005000000 m')
print(f'Fluid volume: CAD {fluid.volume:.12e} m^3; analytic nominal {expected_volume:.12e} m^3')
print('solids', len(fluid.solids()), 'faces', len(fluid.faces()), 'bbox', fluid.bounding_box().min, fluid.bounding_box().max)
