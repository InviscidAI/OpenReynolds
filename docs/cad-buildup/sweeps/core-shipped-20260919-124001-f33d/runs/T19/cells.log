gmsh.model.mesh.field.setAsBackgroundMesh(thr)
gmsh.option.setNumber('Mesh.MeshSizeMin',4e-5); gmsh.option.setNumber('Mesh.MeshSizeMax',6e-4)
gmsh.option.setNumber('Mesh.MshFileVersion',2.2); gmsh.option.setNumber('Mesh.Binary',0)
print('Physical surface areas:', {'shaft':sum(occ.getMass(2,s) for s in shaft_s),'keyway':sum(occ.getMass(2,s) for s in key_s),'bore':occ.getMass(2,bore_s),'end':occ.getMass(2,base)})
gmsh.model.mesh.generate(3); gmsh.write('sealLeakage.msh')
print('nodes',len(gmsh.model.mesh.getNodes()[0]),'volume elements',sum(len(a) for a in gmsh.model.mesh.getElements(3)[1]))
gmsh.finalize()
