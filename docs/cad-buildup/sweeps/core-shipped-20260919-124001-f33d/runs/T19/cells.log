ext=occ.extrude([(2,base)],0,0,L,numElements=[30],recombine=True); occ.synchronize()
top=ext[0][1]; volume=next(t for d,t in ext if d==3); lateral=[t for d,t in ext[1:] if d==2]
flat=[s for s in lateral if gmsh.model.getType(2,s)=='Plane']; curved=[s for s in lateral if s not in flat]
