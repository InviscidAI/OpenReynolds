import pyvista as pv, pathlib
pathlib.Path('t19.foam').touch()
reader=pv.OpenFOAMReader('t19.foam'); reader.set_active_time_value(reader.time_values[-1]); data=reader.read()
print('OpenFOAM blocks:', data.keys())
internal=data['internalMesh']
print('Rendered internal mesh:', internal.n_cells, 'cells,', internal.n_points, 'points, bounds', internal.bounds)
# Clip away the front half to reveal annular thickness and keyway interior.
cut=internal.clip(normal=(0,-1,0), origin=(0,0,0), invert=False)
p=pv.Plotter(off_screen=True,window_size=(950,700)); p.add_mesh(cut,color='lightsteelblue',show_edges=True,line_width=0.25)
p.camera_position=[(0.065,-0.075,0.055),(0,0,0),(0,0,1)]; p.show(screenshot='mesh_cutaway.png')
# End cross-section view, slightly inside the high-pressure end.
sl=internal.slice(normal=(0,0,1),origin=(0,0,0.029))
p2=pv.Plotter(off_screen=True,window_size=(800,800)); p2.add_mesh(sl,color='gold',show_edges=True,line_width=0.5)
p2.view_xy(); p2.show(screenshot='mesh_end_section.png')
