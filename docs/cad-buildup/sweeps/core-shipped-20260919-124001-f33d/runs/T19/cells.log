# -- cell 2 (1.6s, exit 0)
# Rebuild the keyway cutter with explicit minimum alignment: x=-6..+6 mm, y=15..21 mm, z=-30..+30 mm.
keyway_cutter = bd.Pos(-KEY_WIDTH/2, R_SHAFT-KEY_DEPTH, -L/2) * bd.Box(
    KEY_WIDTH, KEY_DEPTH+0.001, L,
    align=(bd.Align.MIN, bd.Align.MIN, bd.Align.MIN))
shaft_solid = shaft_blank - keyway_cutter
fluid = bore_volume - shaft_solid
kb = keyway_cutter.bounding_box()
print('Cutter bbox:', kb.min, kb.max)
print(f'Length measured/requested: {fluid.bounding_box().size.Z:.9f} / {L:.9f} m')
print(f'Radial clearance measured/requested: {R_BORE-R_SHAFT:.9f} / 0.000050000 m')
print(f'Keyway width measured/requested: {kb.size.X:.9f} / {KEY_WIDTH:.9f} m')
print(f'Keyway depth measured/requested: {R_SHAFT-kb.min.Y:.9f} / {KEY_DEPTH:.9f} m')
print(f'Fluid volume: {fluid.volume:.12e} m^3; faces={len(fluid.faces())}, solids={len(fluid.solids())}')
for i,f in enumerate(fluid.faces()):
    c=f.center(); print(i, f.geom_type, f'area={f.area:.9e}', f'center=({c.X:.6g},{c.Y:.6g},{c.Z:.6g})')
