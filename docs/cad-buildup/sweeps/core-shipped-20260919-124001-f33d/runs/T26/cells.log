# -- cell 4 (0.4s, exit 1)
import sys
sys.path.insert(0,'.reference')
from cad_export import export_patches
faces=list(fluid.faces())
shaft_wall=[]; column_faces=[]; floor_faces=[]; opening_faces=[]; tread_faces=[]
for f in faces:
    fb=f.bounding_box()
    if f.geom_type == bd.GeomType.CYLINDER:
        radial_diameter=max(fb.size.X,fb.size.Y)
        if abs(radial_diameter-2*SHAFT_R)<1e-6:
            shaft_wall.append(f)
        elif abs(radial_diameter-2*COLUMN_R)<1e-6:
            column_faces.append(f)
        else:
            raise ValueError(f'unexpected cylindrical diameter {radial_diameter}')
    elif abs(fb.size.Z)<1e-8 and abs(fb.min.Z)<1e-8:
        floor_faces.append(f)
    elif abs(fb.size.Z)<1e-8 and abs(fb.min.Z-HEIGHT)<1e-8:
        opening_faces.append(f)
    else:
        tread_faces.append(f)
print('patch face counts:', {k:len(v) for k,v in {'shaftWall':shaft_wall,'column':column_faces,'treads':tread_faces,'floor':floor_faces,'topOpening':opening_faces}.items()})
print('patch areas m2:', {k:round(sum(f.area for f in v),6) for k,v in {'shaftWall':shaft_wall,'column':column_faces,'treads':tread_faces,'floor':floor_faces,'topOpening':opening_faces}.items()})
Path('constant/triSurface').mkdir(parents=True,exist_ok=True)
export_patches(fluid, {'shaftWall':shaft_wall, 'column':column_faces, 'treads':tread_faces,
                       'floor':floor_faces, 'topOpening':opening_faces},
               tolerance=2.5e-4, output_dir='constant/triSurface')
