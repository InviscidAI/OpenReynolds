# Render final OpenFOAM boundary patches with distinct colors.
Path('t26.foam').touch()
reader=pv.OpenFOAMReader('t26.foam')
reader.set_active_time_value(0.0)
data=reader.read()
print('OpenFOAM blocks:',list(data.keys()))
# Reader supplies a boundary multiblock; select and color each requested patch.
pl=pv.Plotter(off_screen=True,window_size=(900,720))
colors={'shaftWall':'lightgray','column':'gold','treads':'tomato','floor':'saddlebrown','topOpening':'deepskyblue'}
for name,color in colors.items():
    found=None
    for block_name in data.keys():
        if name in str(block_name): found=data[block_name]
    if found is not None:
        pl.add_mesh(found,color=color,opacity=0.30 if name=='shaftWall' else 0.90,label=name)
        print(name,'cells',found.n_cells)
pl.camera_position=[(4.8,-5.3,3.7),(0,0,1.5),(0,0,1)]
pl.add_legend(); pl.add_axes(); pl.show(screenshot='preview/final_mesh_patches.png')
