import subprocess, glob, pyvista as pv
from IPython.display import Image, display
for reg in ("fluid", "solid"):
    subprocess.run(["foamToVTK", "-region", reg, "-constant", "-noZero"], capture_output=True, text=True)
fv = sorted(glob.glob("VTK/**/*fluid*.vtk", recursive=True) + glob.glob("VTK/*fluid*/*.vtk"))
sv = sorted(glob.glob("VTK/**/*solid*.vtk", recursive=True) + glob.glob("VTK/*solid*/*.vtk"))
print(fv[:3], sv[:3])
p = pv.Plotter(off_screen=True, window_size=(1000, 650))
p.add_mesh(pv.read(fv[0]), color="steelblue", opacity=0.25, show_edges=True, edge_color="gray")
p.add_mesh(pv.read(sv[0]), color="orange", show_edges=True)
p.camera_position = [(0.28, -0.22, 0.16), (0.10, 0.015, 0.0), (0, 0, 1)]
p.add_axes(); p.screenshot("regions.png"); display(Image("regions.png"))
