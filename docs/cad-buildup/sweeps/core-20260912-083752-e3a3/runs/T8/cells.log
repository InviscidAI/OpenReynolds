import numpy as np, pyvista as pv
from IPython.display import Image, display

def centres(reg, patch):
    import re
    b = open(f"constant/{reg}/polyMesh/boundary").read()
    m = re.search(patch + r"\s*\{[^}]*nFaces\s+(\d+);[^}]*startFace\s+(\d+);", b, re.S)
    n, s = int(m.group(1)), int(m.group(2))
    P = read_points(f"constant/{reg}/polyMesh/points"); F = read_faces(f"constant/{reg}/polyMesh/faces")
    return np.array(sorted([tuple(P[f].mean(axis=0).round(9)) for f in F[s:s+n]]))

cf, cs = centres("fluid","fluid_to_solid"), centres("solid","solid_to_fluid")
print("max face-centre mismatch across interface:", np.abs(cf-cs).max(), "| all at z=0:", np.allclose(cf[:,2],0))

open("case.foam","w").write("")
p = pv.Plotter(off_screen=True, window_size=(1000,650))
for reg, col in (("fluid","lightblue"), ("solid","orange")):
    r = pv.OpenFOAMReader("case.foam"); r.case_type = "reconstructed"
    import subprocess; subprocess.run(["foamToVTK","-region",reg,"-constant","-excludePatches","()"],capture_output=True,text=True)
p.add_mesh(pv.read(sorted(__import__("glob").glob("VTK/*fluid*/*.vtk"))[0]).extract_all_edges(), color="steelblue", opacity=0.4)
p.add_mesh(pv.read(sorted(__import__("glob").glob("VTK/*solid*/*.vtk"))[0]), color="orange", show_edges=True)
p.camera_position = [(0.28,-0.22,0.16),(0.10,0.015,0.0),(0,0,1)]; p.add_axes()
