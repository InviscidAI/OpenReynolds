from collections import Counter
def face_info(shape):
    info = []
    for f in shape.faces():
        gt = f.geom_type
        r = None
        try:
            r = f.radius
        except Exception:
            pass
        info.append((str(gt), r, f.area))
    return info

for i, s in enumerate(solids):
    print("--- solid", i)
    c = Counter(g for g, r, a in face_info(s))
    print(dict(c))
    rs = sorted(round(r, 3) for g, r, a in face_info(s) if r is not None)
    print("radii:", rs)
