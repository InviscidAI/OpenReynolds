import subprocess, re
cm = subprocess.run(["checkMesh","-allGeometry","-allTopology"], text=True, capture_output=True)
Path("checkMesh.log").write_text(cm.stdout + cm.stderr)
print("\n".join(cm.stdout.splitlines()[-45:]))
if cm.returncode != 0 or "Failed" in cm.stdout:
    raise RuntimeError("checkMesh did not pass")
cz = Path("constant/polyMesh/cellZones").read_text()
bd_txt = Path("constant/polyMesh/boundary").read_text()
for zone in ("heater","cooler"):
    m=re.search(rf'\b{zone}\b\s*\{{.*?cellLabels\s+List<label>\s*(\d+)', cz, re.S)
    print(f"zone {zone}: {m.group(1) if m else 'not parsed'} cells")
m=re.search(r'\bwalls\b\s*\{.*?nFaces\s+(\d+)', bd_txt, re.S)
print(f"boundary walls: {m.group(1) if m else 'not parsed'} faces; type wall")
