import numpy as np, math, pyvista as pv
from pathlib import Path
L = 0.900
X_MID = 0.450
R_OUT = (0.450, 0.430, 0.410)
R_CORE = (0.280, 0.310, 0.250)
N_CAD_SECTIONS = 9

def cosine_radius(x, radii):
    r0, rm, r1 = radii
    if x <= X_MID:
        return r0 + (rm-r0)*0.5*(1-math.cos(math.pi*x/X_MID))
    s = (x-X_MID)/(L-X_MID)
    return rm + (r1-rm)*0.5*(1-math.cos(math.pi*s))

def yz_circle(x, radius):
    plane = bd.Plane(origin=(x,0,0), x_dir=(0,1,0), z_dir=(1,0,0))
    return plane * bd.Circle(radius)

x_sections = np.linspace(0.0, L, N_CAD_SECTIONS)
outer_wires = [yz_circle(float(x), cosine_radius(float(x), R_OUT)) for x in x_sections]
core_wires = [yz_circle(float(x), cosine_radius(float(x), R_CORE)) for x in x_sections]
outer_solid = bd.Solid.make_loft(outer_wires, ruled=False)
core_solid = bd.Solid.make_loft(core_wires, ruled=False)
fluid = outer_solid - core_solid
print('fluid solids:', len(fluid.solids()), 'faces:', len(fluid.faces()))
print('requested/measured axial length [m]:', L, fluid.bounding_box().size.X)
print('requested radii at x=0,0.45,0.9 [m]')
for x, ro_req, ri_req in zip((0.0,X_MID,L), R_OUT, R_CORE):
    print(f' x={x:.3f}: outer {cosine_radius(x,R_OUT):.6f}/{ro_req:.6f}, core {cosine_radius(x,R_CORE):.6f}/{ri_req:.6f}')
print('fluid CAD volume [m3]:', fluid.volume)
verts, tris = fluid.tessellate(0.012)
pts = np.array([[v.X,v.Y,v.Z] for v in verts])
faces = np.hstack([np.full((len(tris),1),3), np.array(tris,dtype=int)]).ravel()
mesh_preview = pv.PolyData(pts, faces)
plotter = pv.Plotter(off_screen=True, window_size=(1000,700))
plotter.add_mesh(mesh_preview, color='lightsteelblue', show_edges=True, opacity=0.70)
plotter.add_axes(); plotter.view_isometric(); plotter.camera.zoom(1.35)
plotter.show(screenshot='coarse_geometry.png')
print('wrote coarse_geometry.png')
