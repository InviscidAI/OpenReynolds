 features ();
 refinementSurfaces
 {
  barrel { level (3 3); patchInfo { type wall; } }
  fins { level (3 3); patchInfo { type wall; } }
  head { level (3 3); patchInfo { type wall; } }
 }
 resolveFeatureAngle 30;
