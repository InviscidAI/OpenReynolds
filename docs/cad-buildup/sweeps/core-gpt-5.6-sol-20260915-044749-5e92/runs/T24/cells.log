# -- cell 1 (2.7s, exit 1)
import build123d as bd, math, numpy as np
from build123d import Cylinder, Box, Pos, Rot, Axis, Vector
# Requested dimensions, metres
D=0.120; R=D/2; H=0.200; OUT_D=0.040
PORT_W=0.020; PORT_H=0.030; PORT_Z0=0.040; DUCT_L=0.050; ANG=15.0
chamber = Cylinder(R, H)
ducts=[]
# At azimuth a, inward flow direction is tangent CCW rotated 15 deg toward radial inward.
for a_deg in (0,90,180,270):
    a=math.radians(a_deg)
    er=np.array([math.cos(a),math.sin(a),0.0]); et=np.array([-math.sin(a),math.cos(a),0.0])
    flow=math.cos(math.radians(ANG))*et-math.sin(math.radians(ANG))*er
    outer=-flow
    wall_center=np.array([R*math.cos(a),R*math.sin(a),PORT_Z0])
    # Box local x runs from wall toward outside; local y is port width; local z port height.
    origin=wall_center
    rot=math.degrees(math.atan2(outer[1],outer[0]))
    duct=Pos(*origin)*Rot(0,0,rot)*Box(DUCT_L,PORT_W,PORT_H,align=(bd.Align.MIN,bd.Align.CENTER,bd.Align.MIN))
    ducts.append(duct)
fluid=chamber
for duct in ducts: fluid=fluid+duct
print('fluid solids:',len(fluid.solids()),'volume m3:',fluid.volume)
print('bounds:',fluid.bounding_box().min,fluid.bounding_box().max)
print('requested/constructed chamber D,H:',D,H,' outlet D:',OUT_D)
print('requested/constructed port W,H,z-bottom:',PORT_W,PORT_H,PORT_Z0)
print('requested/constructed duct axis length and angle off tangent:',DUCT_L,ANG)
# Coarse view
from build123d import export_step
export_step(fluid,'coarse_fluid.step')
import pyvista as pv
pv.start_xvfb(); pl=pv.Plotter(off_screen=True,window_size=(900,650));
# use OCC tessellation through exported STL for viewing
bd.export_stl(fluid,'coarse_fluid.stl',tolerance=0.002,angular_tolerance=0.2)
m=pv.read('coarse_fluid.stl'); pl.add_mesh(m,color='lightsteelblue',show_edges=True); pl.view_isometric(); pl.add_axes(); pl.show(screenshot='coarse_fluid.png')
print('wrote coarse_fluid.png')
