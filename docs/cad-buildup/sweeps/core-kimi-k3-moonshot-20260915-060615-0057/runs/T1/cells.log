# -- cell 7 (0.5s, exit 1)
import pyvista as pv, glob
subprocess.run(["foamToVTK"], capture_output=True, text=True)
vtk = sorted(glob.glob("VTK/t1_*.vtk"))[-1]
m = pv.read(vtk)

# --- measurements from the mesh points ---
pts = pv.read(glob.glob("VTK/t1_*.vtk")[0]).points  # constant time = 0 dir anyway
b = m.bounds
print(f"bounds: x [{b[0]:.4f},{b[1]:.4f}]  y [{b[2]:.4f},{b[3]:.4f}]  z [{b[4]:.4f},{b[5]:.4f}]")

# passage width at inlet: inlet patch faces
import re
def patch_pts(name):
    surf = pv.read(sorted(glob.glob(f"VTK/{name}/"+name+"_*.vtk"))[-1])
    return surf.points
pi = patch_pts("inlet"); po = patch_pts("outlet")
w_in  = pi[:,1].max()-pi[:,1].min()
w_out = po[:,1].max()-po[:,1].min()
print(f"inlet width  = {w_in*1000:.3f} mm  (asked 10)  at x={pi[:,0].mean():.4f}")
print(f"outlet width = {w_out*1000:.3f} mm  (asked 10)  at x={po[:,0].mean():.4f}")
print(f"leg length (inlet x to bend start x=0) = {(0 - pi[:,0].mean())*1000:.3f} mm (asked 120)")
print(f"leg centreline offset = {(po[:,1].mean()-pi[:,1].mean())*1000:.3f} mm (asked 2*Rc=30)")

# bend radii: wall points near the bend (x>0)
pw = patch_pts("walls")
bw = pw[pw[:,0] > 1e-6]
r = np.hypot(bw[:,0], bw[:,1])
print(f"bend inner radius = {r.min()*1000:.3f} mm (asked {Ri*1000:.1f})")
print(f"bend outer radius = {r.max()*1000:.3f} mm (asked {Ro*1000:.1f})")

# --- render ---
pl = pv.Plotter(off_screen=True, window_size=(1100,600))
pl.add_mesh(m, style="wireframe", color="k", line_width=0.6)
pl.add_mesh(m.extract_cells(np.arange(0,m.n_cells,37)), color="lightblue", opacity=0.5)
pl.view_xy(); pl.camera.zoom(1.1)
pl.add_title(f"U-bend 2D structured mesh, {m.n_cells} cells (coarse)")
pl.show()
