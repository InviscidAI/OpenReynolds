import os
os.makedirs("constant/triSurface", exist_ok=True)

# --- top annulus (top patch) = disk R with hole R_OUT, at z=H ---
top_annulus = bd.Pos(0, 0, H) * (
    bd.make_face(bd.Circle(R).edges()) - bd.make_face(bd.Circle(R_OUT).edges())
)

# --- classify the solid's faces into patches ---
patches = {}
faces = list(fluid.faces())

def local_coords(c, fr):
    rel = np.array([c.X - fr["P"][0], c.Y - fr["P"][1], c.Z - fr["P"][2]])
    return rel @ fr["u"], rel @ fr["y"], rel @ np.array([0, 0, 1.0])

def box_dist(d, s, z):
    # distance from local point to the duct box [0,L]x[-W/2,W/2]x[-H/2,H/2]
    dd = max(0.0 - d, d - DUCT_L, 0.0)
    ds = max(abs(s) - DUCT_W/2, 0.0)
    dz = max(abs(z) - DUCT_H/2, 0.0)
    return math.sqrt(dd*dd + ds*ds + dz*dz)

unassigned = []
for f in faces:
    c = f.center()
    gt = str(f.geom_type)
    if gt == "GeomType.CYLINDER":
        patches.setdefault("wall", []).append(f)
    elif abs(c.Z - 0.0) < 1e-9 and f.area > 0.005:
        patches.setdefault("floor", []).append(f)
    elif abs(c.Z - H) < 1e-9 and f.area > 0.005:
        pass  # solid's full top disk: replaced by top_annulus + outlet_face
    else:
        best, bi = 1e9, None
        for fr in duct_frames:
            d, s, z = local_coords(c, fr)
            dist = box_dist(d, s, z)
            if dist < best:
                best, bi = dist, fr["i"]
        if best > 1e-6:
            unassigned.append((c, f.area, best))
        else:
            d, s, z = local_coords(c, duct_frames[bi])
            if abs(d - DUCT_L) < 1e-9:
                patches.setdefault(f"inlet{bi+1}", []).append(f)
            else:
                patches.setdefault(f"ductWall{bi+1}", []).append(f)

patches["top"] = [top_annulus]
patches["outlet"] = [outlet_face]

print("unassigned faces:", unassigned)
for name in sorted(patches):
    comp = bd.Compound.make_compound(patches[name])
    bd.export_stl(comp, f"constant/triSurface/{name}.stl")
    print(f"{name:10s} faces={len(patches[name]):2d}  area={comp.area:.6f} m^2")
print(sorted(os.listdir("constant/triSurface")))
