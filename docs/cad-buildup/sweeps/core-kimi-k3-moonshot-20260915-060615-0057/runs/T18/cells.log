# -- cell 3 (0.1s, exit 1)
import os
os.makedirs("constant/triSurface", exist_ok=True)

barrel_faces, fin_faces, head_faces = [], [], []
for f in cyl_solid.faces():
    gt = f.geom_type
    c = f.center()
    r = np.hypot(c.x, c.y)
    if gt == "SPHERE":
        head_faces.append(f)
    elif gt == "CYLINDER":
        (barrel_faces if r < 0.06 else fin_faces).append(f)
    elif gt == "PLANE":
        if abs(c.z) < 1e-9:          # bottom disk of barrel
            barrel_faces.append(f)
        else:                        # annular fin top/bottom
            fin_faces.append(f)
    else:
        print("unclassified:", gt, c)

print("barrel:", len(barrel_faces), "fins:", len(fin_faces), "head:", len(head_faces))

groups = {"barrel": barrel_faces, "fins": fin_faces, "head": head_faces}
for name, fl in groups.items():
    comp = bd.Compound(children=fl)
    bd.export_stl(comp, f"constant/triSurface/{name}.stl")
    print(name, "area =", round(sum(f.area for f in fl), 6), "m^2")

# sanity: expected areas
print("expected barrel side+rim area ~", 2*np.pi*R_BARREL*H_BARREL + np.pi*R_BARREL**2)
print("expected fins area ~", N_FIN*(2*np.pi*(R_FIN**2-R_BARREL**2) + 2*np.pi*R_FIN*T_FIN))
print("expected head area ~", 2*np.pi*R_BARREL**2)
