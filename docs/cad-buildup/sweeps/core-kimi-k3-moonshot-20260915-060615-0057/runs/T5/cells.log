# -- cell 14 (0.2s, exit 1)
# classify properly against B's boundary, and test identity of region2 vs solid 0
Bmin, Bmax = B.bounding_box().min, B.bounding_box().max
for j, s in enumerate(ns):
    sb = s.bounding_box()
    touch = any(abs(sb.min[k]-Bmin[k])<1e-6 or abs(sb.max[k]-Bmax[k])<1e-6 for k in range(3))
    print(j, "vol", round(s.volume,1), "touches B wall:", touch)
inter = ns[1].intersect(solids[0])
print("region1 ∩ solid0 volume:", round(inter.volume if hasattr(inter,'volume') else -1, 2))
print("solid0 volume:", round(solids[0].volume,2))
# is solid 0 inside union?
from build123d import Vector
c = solids[0].center()
print("s0 center in union:", union.is_inside(c))
print("union solid volumes:", [round(s.volume,1) for s in union.solids()])
