import build123d as bd
import numpy as np, os

# Dimensions in METRES (OpenFOAM reads raw numbers as metres).
# Stations along axis z: fan exit 0, mid 0.45, nozzle 0.90
Z = [0.0, 0.45, 0.90]
R_OUT = [0.450, 0.430, 0.410]   # outer cowl inner surface
R_IN  = [0.280, 0.310, 0.250]   # core cowl outer surface

os.makedirs("constant/triSurface", exist_ok=True)

# Splines in the r-z plane (x = r, y = z), smooth blend through the 3 stations
outer_edge = bd.Spline([(z, r, 0) for z, r in zip(Z, R_OUT)])
inner_edge = bd.Spline([(z, r, 0) for z, r in zip(Z, R_IN)])

axis = bd.Axis((0, 0, 0), (0, 0, 1))

# Revolve each spline edge about the axis -> one surface per cowl patch
outer_cowl = bd.revolve(outer_edge, axis)   # Face (surface of revolution)
core_cowl  = bd.revolve(inner_edge, axis)

# Annular end rings at fan exit and nozzle
ring_in  = bd.Plane(origin=(0, 0, 0.0), z_dir=(0, 0, 1)) * (bd.Circle(R_OUT[0]) - bd.Circle(R_IN[0]))
ring_out = bd.Plane(origin=(0, 0, 0.9), z_dir=(0, 0, 1)) * (bd.Circle(R_OUT[2]) - bd.Circle(R_IN[2]))

# --- Verify: radii of each revolved surface at the three stations ---
def radii_at(face, zvals):
    out = []
    for z in zvals:
        # intersect surface with plane z=const: sample tessellation points near that z
        pts = face.tessellate(0.002)[0]
        pts = np.array([(p.X, p.Y, p.Z) for p in pts])
        near = pts[np.abs(pts[:, 2] - z) < 0.005]
        out.append(np.sqrt(near[:, 0]**2 + near[:, 1]**2).max())
    return out

print("outer cowl radii @stations:", np.round(radii_at(outer_cowl, Z), 4), "target:", R_OUT)
print("core cowl  radii @stations:", np.round(radii_at(core_cowl, Z), 4), "target:", R_IN)
print("surfaces:", outer_cowl.is_valid(), core_cowl.is_valid(), ring_in.is_valid(), ring_out.is_valid())
print("areas: outer %.4f core %.4f rin %.5f rout %.5f m^2" % (
    outer_cowl.area, core_cowl.area, ring_in.area, ring_out.area))
# -- output
