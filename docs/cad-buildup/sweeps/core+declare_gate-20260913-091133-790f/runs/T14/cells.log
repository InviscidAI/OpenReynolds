                  ("rootWall", rootWall), ("farfield", farfield)]:
    export_stl(shp, f"constant/triSurface/{name}.stl", tolerance=2e-5, angular_tolerance=0.1)
    print(name, os.path.getsize(f"constant/triSurface/{name}.stl"))
