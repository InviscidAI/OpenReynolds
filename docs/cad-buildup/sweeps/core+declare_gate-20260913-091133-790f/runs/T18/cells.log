import pyvista as pv
pv.start_xvfb() if False else None
pv.OFF_SCREEN=True
def look(fn="mesh.png"):
    m = pv.OpenFOAMReader("case.foam"); m.set_active_time_value(0) if False else None
    grid = m.read()["internalMesh"]
    sl = grid.slice(normal="y")
    p = pv.Plotter(off_screen=True, window_size=(700,900))
    p.add_mesh(sl, show_edges=True, color="lightsteelblue", line_width=0.4)
    p.camera_position="xz"; p.screenshot(fn); p.close()
    return fn
open("case.foam","w").write("")
from IPython.display import Image, display
display(Image(look()))
