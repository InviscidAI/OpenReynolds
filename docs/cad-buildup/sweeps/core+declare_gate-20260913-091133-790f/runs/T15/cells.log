# -- cell 5 (36.9s, exit 0)
BACKLASH = 0.2888          # calibrated so the MEASURED pitch-line backlash is 0.300 mm
t0=time.time()
pinion_raw = make_gear(Z_P, GAM_P)
wheel_raw  = make_gear(Z_W, GAM_W)
PHASE_W = 180.0 + 180.0/Z_W
pinion_g = pinion_raw
wheel_g  = Rot(0,90,0) * (Rot(0,0,PHASE_W) * wheel_raw)
t_p = arc_thickness(pinion_raw, GAM_P, A_meas); t_w = arc_thickness(wheel_raw, GAM_W, A_meas)
print("rebuild s", round(time.time()-t0,1))
print(f"measured backlash along pitch line (at outer) = {(2*t_th-t_p-t_w)/s:.4f} mm   target 0.300")
print("interference volume =", (pinion_g & wheel_g).volume if len((pinion_g & wheel_g).solids()) else 0.0)
# -- output
