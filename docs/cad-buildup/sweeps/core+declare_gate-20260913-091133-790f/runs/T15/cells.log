# -- cell 6 (4.1s, exit 0)
LX,LY,LZ = 160.0,140.0,120.0          # cavity, mm
TW  = 8.0                              # wall thickness the bore passes through
RSH_P, RSH_W = 10.0, 12.0              # shaft radii
CLR = 4.0                              # radial oil clearance in each bore
RB_P, RB_W = RSH_P+CLR, RSH_W+CLR

def cyl_along(axis, a0, a1, r):
    c = Pos(0,0,(a0+a1)/2) * Cylinder(radius=r, height=a1-a0)
    return c if axis=="z" else Rot(0,90,0)*c

box      = Box(LX,LY,LZ)
bore_p   = cyl_along("z", LZ/2, LZ/2+TW, RB_P)
bore_w   = cyl_along("x", LX/2, LX/2+TW, RB_W)
shaft_p  = cyl_along("z", 32.0, LZ/2+TW, RSH_P)
shaft_w  = cyl_along("x", 20.0, LX/2+TW, RSH_W)
pin_asm  = pinion_g + shaft_p
whl_asm  = wheel_g  + shaft_w
t0=time.time()
fluid = (box + bore_p + bore_w) - pin_asm - whl_asm
print("cut s", round(time.time()-t0,1), "solids", len(fluid.solids()), "faces", len(fluid.faces()))
print("fluid volume mm^3", round(fluid.volume,1), " box alone", LX*LY*LZ)
print("bbox", fluid.bounding_box())
# -- output
cut s 2.6 solids 1 faces 1672
fluid volume mm^3 2582166.5  box alone 2688000.0
bbox bbox: -80.0 <= x <= 88.0, -70.0 <= y <= 70.0, -60.0 <= z <= 68.0

# -- cell 7 (240.0s, exit 0)
from OCP.TopAbs import TopAbs_ON

def on_solid(solid, p, tol=1e-6):
    c = BRepClass3d_SolidClassifier(solid.wrapped, gp_Pnt(*p), tol)
    return c.State() == TopAbs_ON

patches = {k: [] for k in ("pinion","wheel","walls","bore_pinion","bore_wheel")}
t0=time.time()
for f in fluid.faces():
    p = f.position_at(0.5,0.5)
    p = (p.X,p.Y,p.Z)
    if   on_solid(pin_asm, p):        patches["pinion"].append(f)
    elif on_solid(whl_asm, p):        patches["wheel"].append(f)
    elif p[2] > LZ/2 + 1e-6:          patches["bore_pinion"].append(f)
    elif p[0] > LX/2 + 1e-6:          patches["bore_wheel"].append(f)
    else:                             patches["walls"].append(f)
print("classify s", round(time.time()-t0,1))
for k,v in patches.items(): print(f"{k:12s} {len(v):5d} faces  area {sum(x.area for x in v)/100:9.2f} cm^2")
print("total faces", sum(len(v) for v in patches.values()), "of", len(fluid.faces()))
# -- output


