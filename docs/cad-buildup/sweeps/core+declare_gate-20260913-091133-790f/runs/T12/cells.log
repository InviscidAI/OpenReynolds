# -- cell 4 (0.2s, exit 1)
import collections
groups = collections.defaultdict(list)
for f in fluid.faces():
    g = f.geom_type
    c = f.center()
    if g == GeomType.PLANE:
        n = f.normal_at(c)
        if abs(n.Z) > 0.99:
            z = c.Z
            if abs(z) < 1e-6: key = "backplate"
            elif abs(z-H_HUB) < 1e-6: key = "inlet"
            elif abs(z-H_BLADE) < 1e-6: key = "shroud"
            else: key = "?plane_z%.2f" % z
        else: key = "blades"
    elif g == GeomType.CYLINDER:
        rad = f.radius
        if abs(rad-R_HUB) < 1e-6: key = "hub"
        elif abs(rad-R_OUT) < 1e-6: key = "outlet"
        elif abs(rad-R_EYE) < 1e-6: key = "shroud"     # eye outer wall z14..18
        else: key = "?cyl_r%.2f" % rad
    else: key = "blades"
    groups[key].append(f)
for k,v in groups.items(): print(k, len(v), round(sum(f.area for f in v),1))
