def walk(b,acc):
    for i in range(b.n_blocks):
        x=b[i]
        if isinstance(x,pv.MultiBlock): walk(x,acc)
        elif x is not None: acc.append((b.get_block_name(i),x))
    return acc
blocks = walk(m,[])
cad_area = {"outerCowl":2.4340,"coreCowl":1.6795,"fanInlet":0.38987,"nozzleOutlet":0.33175}
