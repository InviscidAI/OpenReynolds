def runner_plane(x, s):
    return Plane(origin=(x, 0, 0), x_dir=(0, s, 0), z_dir=(s, 0, 0))

def runner_path(x, s):
    y0, y1 = W_PL/2 - 10.0, W_PL/2 + L_STR        # local u coords (outboard distance)
    ln = Line((y0, 0), (y1, 0))
