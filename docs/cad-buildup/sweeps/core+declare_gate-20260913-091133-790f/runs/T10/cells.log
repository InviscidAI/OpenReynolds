from build123d import *

def section_wire(r, theta0=0.0):
    """Closed 3D wire of the section at radius r, starting and ending at the sharp TE."""
    (xu,yu),(xl,yl) = section_2d()
    # TE -> lower surface -> LE -> upper surface -> TE
    x = np.concatenate([xl[::-1], xu[1:]])
    y = np.concatenate([yl[::-1], yu[1:]])
    xi = stagger_at(r)
    a = x*np.cos(xi) - y*np.sin(xi); s = x*np.sin(xi) + y*np.cos(xi)
    a0, s0 = section_planar(r)          # same centroid shift
    a = a - (a.mean() if False else (np.concatenate([xl[::-1],xu[1:]])*np.cos(xi)-np.concatenate([yl[::-1],yu[1:]])*np.sin(xi)).mean())
    s = s - (np.concatenate([xl[::-1],xu[1:]])*np.sin(xi)+np.concatenate([yl[::-1],yu[1:]])*np.cos(xi)).mean()
    th = theta0 + s/r
    pts = [Vector(float(ai), float(r*np.cos(t)), float(r*np.sin(t))) for ai,t in zip(a, th)]
    return Wire(Spline(*pts, *[pts[0]]).edge())

w0 = section_wire(radii[0])
print("wire closed:", w0.is_closed, " length:", w0.length)
blade0 = loft([section_wire(r) for r in radii], ruled=False)
print(type(blade0), "volume m^3:", blade0.volume, " bbox:", blade0.bounding_box())
