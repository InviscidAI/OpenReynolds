from OCP.BRepMesh import BRepMesh_IncrementalMesh
from OCP.BRep import BRep_Tool
from OCP.TopAbs import TopAbs_REVERSED

BRepMesh_IncrementalMesh(fluid.wrapped, 0.0005, False, 0.3, True)

def tri_of(faces):
    tris = []
    for f in faces:
        loc = TopLoc_Location()
        poly = BRep_Tool.Triangulation_s(f.wrapped, loc)
        trsf = loc.Transformation()
        pts = [poly.Node(i).Transformed(trsf) for i in range(1, poly.NbNodes()+1)]
        rev = f.wrapped.Orientation() == TopAbs_REVERSED
        for i in range(1, poly.NbTriangles()+1):
            a, b, c = poly.Triangle(i).Get()
            if rev: a, c = c, a
            tris.append(tuple((p.X(), p.Y(), p.Z()) for p in (pts[a-1], pts[b-1], pts[c-1])))
    return tris

alltris = {k: tri_of(v) for k, v in groups.items()}
for k, t in alltris.items():
    with open(f"constant/triSurface/{k}.stl", "w") as fh:
        write_solid(fh, k, t)
with open("constant/triSurface/brakeDisc.stl", "w") as fh:
    for k, t in alltris.items():
        write_solid(fh, k, t)
print({k: len(t) for k, t in alltris.items()})
