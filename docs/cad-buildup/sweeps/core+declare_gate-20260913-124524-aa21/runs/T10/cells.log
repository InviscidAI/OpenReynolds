def theta_cam(r, z):
    """tangential angle of the camber surface at radius r, axially clamped beyond LE/TE"""
    zc, tc = to_zt(r, XC, YC)
    return float(np.interp(z, zc, tc))/r

def cyl(p):  return np.hypot(p.X, p.Y), np.arctan2(p.Y, p.X), p.Z

labels = {}
for i, f in enumerate(passage.faces()):
    u = 0.5*(f.geom_adaptor().FirstUParameter()+f.geom_adaptor().LastUParameter())
    v = 0.5*(f.geom_adaptor().FirstVParameter()+f.geom_adaptor().LastVParameter())
    p = f.position_at(u, v); n = f.normal_at(p)
    r, th, z = cyl(p)
    d = np.degrees(th - theta_cam(r, z))
    et = np.array([-np.sin(th), np.cos(th), 0.0])       # tangential unit vector
    ndott = float(np.array([n.X, n.Y, n.Z]) @ et)
    if f.geom_type == GeomType.CYLINDER and abs(r-R_HUB) < 1e-5:   lab = "hub"
    elif f.geom_type == GeomType.CYLINDER and abs(r-R_TIP) < 1e-5: lab = "shroud"
    elif abs(abs(n.Z)-1) < 1e-6 and z < 0:   lab = "inlet"
    elif abs(abs(n.Z)-1) < 1e-6 and z > 0:   lab = "outlet"
    elif d >  3.0:  lab = "periodic_upper"
    elif d < -3.0:  lab = "periodic_lower"
    else:           lab = "blade_suction" if ndott < 0 else "blade_pressure"
    labels.setdefault(lab, []).append(i)
    print("%2d %-15s dtheta=%7.2f deg  n.e_t=%+6.3f  r=%.1f z=%6.1f mm" % (i, lab, d, ndott, r*1e3, z*1e3))
print({k: v for k, v in labels.items()})
