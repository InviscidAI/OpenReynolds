s += [f"    ({v[0]:.9g} {v[1]:.9g} {v[2]:.9g})\n" for v in verts]
s.append(");\n\nblocks\n(\n")
for vs,n in blocks:
    s.append("    hex (" + " ".join(map(str,vs)) + f") ({n[0]} {n[1]} {n[2]}) simpleGrading (1 1 1)\n")
s.append(");\n\nedges\n(\n")
