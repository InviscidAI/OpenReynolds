# -- cell 20 (240.0s, exit 0)
import os
from OCP.BRepAlgoAPI import BRepAlgoAPI_Defeaturing
from OCP.TopTools import TopTools_ListOfShape
from build123d import *
STEP_IN = "/home/qiuzi/.openreynolds-buildup/work/T5-20260913-135927-b3b0/geometry/assembly.step"
R_SMALL = 1.0  # mm; fillets <= this are below the cell size and get removed
if not os.path.exists("sensor_defeatured_mm.step"):
    asm_ = import_step(STEP_IN)
    sol_ = asm_.solids()
    out_ = []
    for s in sol_:
        sm = [f for f in s.faces() if getattr(f, 'radius', None) is not None and f.radius <= R_SMALL]
        if sm:
            d = BRepAlgoAPI_Defeaturing(); d.SetShape(s.wrapped)
            l = TopTools_ListOfShape()
            for f in sm: l.Append(f.wrapped)
            d.AddFacesToRemove(l); d.Build()
            out_.append(Solid(d.Shape()))
        else:
            out_.append(s)
    defeat_mm = Compound(children=out_)
    export_step(defeat_mm, "sensor_defeatured_mm.step")
    print("built", [round(s.volume,2) for s in out_])
print("exists", os.path.exists("sensor_defeatured_mm.step"))
