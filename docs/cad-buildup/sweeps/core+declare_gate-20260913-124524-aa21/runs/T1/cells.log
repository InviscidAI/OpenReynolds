m = pv.read("VTK/t1_0.vtm").combine()
p = np.asarray(m.points)
xy = p[np.isclose(p[:,2],0.0)]
# inlet / outlet edges at x=0
inl = xy[np.isclose(xy[:,0],0.0) & (xy[:,1]<0)]
out = xy[np.isclose(xy[:,0],0.0) & (xy[:,1]>0)]
print("inlet  y-range %.4f..%.4f  width %.4f m" % (inl[:,1].min(), inl[:,1].max(), inl[:,1].ptp()))
print("outlet y-range %.4f..%.4f  width %.4f m" % (out[:,1].min(), out[:,1].max(), out[:,1].ptp()))
print("leg length (x=0 -> bend start x=%.3f): %.4f m" % (XB, XB))
rad = np.hypot(xy[:,0]-XB, xy[:,1])
bend = xy[xy[:,0] > XB+1e-9]
rb = np.hypot(bend[:,0]-XB, bend[:,1])
print("bend radii: inner %.4f  outer %.4f  centreline %.4f m" % (rb.min(), rb.max(), 0.5*(rb.min()+rb.max())))
print("passage width in bend: %.4f m" % (rb.max()-rb.min()))
print("cells %d, volume %.4e vs exact %.4e" % (m.n_cells, m.volume, face.area*TH))

pl = pv.Plotter(off_screen=True, window_size=(900,400))
pl.add_mesh(m, show_edges=True, color="lightsteelblue")
pl.view_xy(); pl.screenshot("mesh.png")
