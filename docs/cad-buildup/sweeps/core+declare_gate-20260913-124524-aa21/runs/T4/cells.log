import numpy as np
fluid = Scale(mm) * fluid_mm          # metres
bb = fluid.bounding_box(); print("bbox m:", bb)

# inlet / outlet are the authored end planes of leg1 (x=0) and leg3 (x=PL)
def pick(sel, xval):
    return [f for f in fluid.faces()
            if abs(f.center().X - xval) < 1e-9 and abs(abs(f.normal_at(f.center()).X)-1) < 1e-6]
inlet_fs  = pick(None, 0.0)
outlet_fs = pick(None, PL*mm)
print("n inlet faces", len(inlet_fs), "areas mm2", [f.area/mm**2 for f in inlet_fs],
      "centres", [tuple(round(c/mm,2) for c in f.center()) for f in inlet_fs])
print("n outlet faces", len(outlet_fs), "areas mm2", [f.area/mm**2 for f in outlet_fs],
      "centres", [tuple(round(c/mm,2) for c in f.center()) for f in outlet_fs])
wall_fs = [f for f in fluid.faces() if f not in inlet_fs + outlet_fs]
print("wall faces", len(wall_fs), "total faces", len(fluid.faces()))
