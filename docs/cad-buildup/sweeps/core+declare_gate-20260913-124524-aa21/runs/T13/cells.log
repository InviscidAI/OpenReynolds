    rmin = min(np.hypot(bb[0],bb[1]), np.hypot(bb[3],bb[4]))
    print(f"{names[i]:5s} surf {lat[i][0]:4d}  x[{bb[0]:7.3f},{bb[3]:7.3f}] y[{bb[1]:7.3f},{bb[4]:7.3f}] z[{bb[2]:6.3f},{bb[5]:6.3f}]")
