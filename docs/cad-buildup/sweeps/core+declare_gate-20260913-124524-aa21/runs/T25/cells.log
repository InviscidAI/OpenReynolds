def tag_group(t):
    x0,_,_,x1,_,_ = gmsh.model.getBoundingBox(2,t)
    if (x1-x0) < 1e-5:
        xm = 0.5*(x0+x1)
        for x,nm in [(0.0,"inlet"),(2.6,"bypass_outlet"),(3.0,"core_outlet")]:
            if abs(xm-x) < 1e-5: return nm
    return "walls"
