m = rd.read(); bnd = m["boundary"]
pl = pv.Plotter(off_screen=True, window_size=(1100,500), shape=(1,2))
cols={"pinion":"orange","wheel":"steelblue","cavityWalls":"lightgrey","shaftBorePinion":"red","shaftBoreWheel":"green"}
