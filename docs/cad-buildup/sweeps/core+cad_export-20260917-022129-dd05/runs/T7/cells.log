        source boxToCell;
        box ({HEATER_MIN[0]} {HEATER_MIN[1]} {HEATER_MIN[2]}) ({HEATER_MAX[0]} {HEATER_MAX[1]} {HEATER_MAX[2]});
    }}
    {{
        name heater;
