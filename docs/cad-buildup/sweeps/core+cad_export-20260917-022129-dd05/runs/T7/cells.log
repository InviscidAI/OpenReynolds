# -- cell 1 (0.3s, exit 1)
from pathlib import Path
import subprocess, textwrap

# Geometry and coarse-mesh dimensions, all in metres.
L, W, H = 0.100, 0.060, 0.040
CELL = 0.005
NX, NY, NZ = round(L/CELL), round(W/CELL), round(H/CELL)

Path("system").mkdir(exist_ok=True)
block_mesh_dict = f'''FoamFile
{{
    format ascii;
    class dictionary;
    object blockMeshDict;
}}
convertToMeters 1;

vertices
(
    (0 0 0)
    ({L} 0 0)
    ({L} {W} 0)
    (0 {W} 0)
    (0 0 {H})
    ({L} 0 {H})
    ({L} {W} {H})
    (0 {W} {H})
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ({NX} {NY} {NZ}) simpleGrading (1 1 1)
);

edges ();

boundary
(
    walls
    {{
        type wall;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
            (0 1 5 4)
            (3 7 6 2)
            (0 4 7 3)
            (1 2 6 5)
        );
    }}
);

mergePatchPairs ();
'''
Path("system/blockMeshDict").write_text(block_mesh_dict)
result = subprocess.run(["blockMesh"], text=True, capture_output=True)
print(result.stdout[-2500:])
if result.returncode:
    print(result.stderr)
    raise RuntimeError(f"blockMesh failed with code {result.returncode}")
print(f"Requested cavity: {L:.3f} x {W:.3f} x {H:.3f} m")
print(f"Coarse divisions: {NX} x {NY} x {NZ} = {NX*NY*NZ} cells; nominal size {CELL:.3f} m")
