# -- cell 10 (0.1s, exit 0)
for i,s in enumerate(solids,1):
    V,E,F=len(s.vertices()),len(s.edges()),len(s.faces())
    chi=V-E+F
    genus=(2-chi)/2
    print(f'solid {i} ({["BASE","EMITTER","BODY"][i-1]}): V={V}, E={E}, F={F}, Euler={chi}, closed-shell genus={genus:g}')
