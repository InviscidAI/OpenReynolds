# -- cell 8 (0.4s, exit 1)
from pathlib import Path
import math, subprocess
Path("system").mkdir(exist_ok=True)
RI = 0.012
s = RI/math.sqrt(2); q = R/math.sqrt(2)
zplanes = [0.0, FLANGE_T, FLANGE_T+GASKET_T, TOTAL_L]
xy = [(s,s),(-s,s),(-s,-s),(s,-s),(q,q),(-q,q),(-q,-q),(q,-q)]
verts = [(x,y,z) for z in zplanes for x,y in xy]
blocks2d = [(2,3,0,1),(3,7,4,0),(0,4,5,1),(1,5,6,2),(2,6,7,3)]
axial_cells = [8,1,8]
lines = ["FoamFile { version 2.0; format ascii; class dictionary; object blockMeshDict; }", "scale 1;", "vertices ("]
lines += [f"    ({x:.12g} {y:.12g} {z:.12g})" for x,y,z in verts]
lines += [");", "blocks ("]
for k,nz in enumerate(axial_cells):
    for bi,b in enumerate(blocks2d):
        lo=[8*k+i for i in b]; hi=[8*(k+1)+i for i in b]
        cells=(8,8,nz) if bi==0 else (5,8,nz)
        lines.append(f"    hex ({' '.join(map(str,lo+hi))}) ({cells[0]} {cells[1]} {cells[2]}) simpleGrading (1 1 1)")
lines += [");", "edges ("]
for p,z in enumerate(zplanes):
    base=8*p
    for a,b,mx,my in [(7,4,R,0),(4,5,0,R),(5,6,-R,0),(6,7,0,-R)]:
        lines.append(f"    arc {base+a} {base+b} ({mx:.12g} {my:.12g} {z:.12g})")
lines += [");", "boundary ("]
# End patches: one face from each cross-sectional block.
for name,k,top in [("inlet",0,False),("outlet",2,True)]:
    lines += [f"    {name} {{ type patch; faces ("]
    for b in blocks2d:
        ids=[8*(k+(1 if top else 0))+i for i in b]
        if not top: ids=list(reversed(ids))
        lines.append(f"        ({' '.join(map(str,ids))})")
    lines += ["    ); }"]
# Four curved outer faces per axial wall segment.
outer_pairs=[(7,4),(4,5),(5,6),(6,7)]
for k,name in enumerate(["flange1_bore_wall","gasket_inner_face","flange2_bore_wall"]):
    lines += [f"    {name} {{ type wall; faces ("]
    for a,b in outer_pairs:
        lines.append(f"        ({8*k+a} {8*k+b} {8*(k+1)+b} {8*(k+1)+a})")
    lines += ["    ); }"]
lines += [");", "mergePatchPairs ();", ""]
Path("system/blockMeshDict").write_text("\n".join(lines))
res=subprocess.run(["blockMesh"], text=True, capture_output=True)
print(res.stdout[-3000:])
print(res.stderr)
res.check_returncode()
