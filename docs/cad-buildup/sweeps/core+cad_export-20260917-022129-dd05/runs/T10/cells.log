# -- cell 1 (0.3s, exit 1)
import numpy as np, math, matplotlib.pyplot as plt
# Requested dimensions, in metres
HUB_R = 0.045
TIP_R = 0.090
BLADE_H = TIP_R - HUB_R
N_BLADES = 28
PITCH_ANG = 2*np.pi/N_BLADES
CHORD = 0.022
ROOT_STAGGER_DEG = 30.0
TWIST_DEG = 35.0
# Assumption: “cambered aerofoil” is represented by a closed-TE NACA 4406 section:
CAMBER = 0.04
CAMBER_POS = 0.40
THICKNESS = 0.06
X_INLET = -CHORD
X_OUTLET = CHORD*np.cos(np.deg2rad(ROOT_STAGGER_DEG)) + CHORD

def section_xy(q, side):
    """NACA section coordinates in chord axes; side=+1 suction, -1 pressure."""
    q = np.asarray(q, dtype=float)
    yc = np.where(q < CAMBER_POS,
                  CAMBER/CAMBER_POS**2*(2*CAMBER_POS*q-q*q),
                  CAMBER/(1-CAMBER_POS)**2*((1-2*CAMBER_POS)+2*CAMBER_POS*q-q*q))
    dy = np.where(q < CAMBER_POS,
                  2*CAMBER/CAMBER_POS**2*(CAMBER_POS-q),
                  2*CAMBER/(1-CAMBER_POS)**2*(CAMBER_POS-q))
    yt = 5*THICKNESS*(0.2969*np.sqrt(q)-0.1260*q-0.3516*q*q+0.2843*q**3-0.1036*q**4)
    a = np.arctan(dy)
    X = CHORD*(q - side*yt*np.sin(a))
    Y = CHORD*(yc + side*yt*np.cos(a))
    return X, Y

def blade_surface(q, r, side, blade_index):
    """Return axial x and angle theta on a named blade side."""
    q, r = np.broadcast_arrays(np.asarray(q, float), np.asarray(r, float))
    beta = np.deg2rad(ROOT_STAGGER_DEG + TWIST_DEG*(r-HUB_R)/BLADE_H)
    X, Y = section_xy(q, side)
    x = X*np.cos(beta) - Y*np.sin(beta)
    s = X*np.sin(beta) + Y*np.cos(beta)
    theta = blade_index*PITCH_ANG + s/r
    return x, theta

# Coarse surface preview of the requested passage envelope.
qv=np.linspace(0,1,31); rv=np.linspace(HUB_R,TIP_R,9)
Q,R=np.meshgrid(qv,rv)
Xp,Tp=blade_surface(Q,R,-1,-0.5)  # pressure face of lower blade
Xs,Ts=blade_surface(Q,R,+1,+0.5)  # suction face of upper neighbour
fig=plt.figure(figsize=(8,5)); ax=fig.add_subplot(111,projection='3d')
for X,T,C in [(Xp,Tp,'tomato'),(Xs,Ts,'royalblue')]:
    ax.plot_surface(X,R*np.cos(T),R*np.sin(T),color=C,alpha=.8,linewidth=0)
for rr in (HUB_R,TIP_R):
    ax.plot(Xp[0 if rr==HUB_R else -1],rr*np.cos(Tp[0 if rr==HUB_R else -1]),rr*np.sin(Tp[0 if rr==HUB_R else -1]),'k-',lw=.7)
    ax.plot(Xs[0 if rr==HUB_R else -1],rr*np.cos(Ts[0 if rr==HUB_R else -1]),rr*np.sin(Ts[0 if rr==HUB_R else -1]),'k-',lw=.7)
ax.set(xlabel='axial x [m]',ylabel='y [m]',zlabel='z [m]'); ax.set_box_aspect((1.1,1,1)); ax.view_init(24,-55); plt.tight_layout(); plt.show()
# Direct checks against the stated dimensions.
qq=np.linspace(0,1,2001); Xu,Yu=section_xy(qq,+1); Xl,Yl=section_xy(qq,-1)
normal_thickness=np.hypot(Xu-Xl,Yu-Yl)
print(f'hub radius: {HUB_R*1e3:.3f} mm (requested 45)')
print(f'tip radius: {TIP_R*1e3:.3f} mm (requested 90)')
print(f'blade height: {BLADE_H*1e3:.3f} mm (requested 45)')
print(f'pitch: {np.rad2deg(PITCH_ANG):.9f} deg (=360/28)')
print(f'root/tip stagger: {ROOT_STAGGER_DEG:.3f}/{ROOT_STAGGER_DEG+TWIST_DEG:.3f} deg (requested 30 and +35 twist)')
print(f'chord endpoints: {np.hypot(*(np.subtract(section_xy(np.array([1.]),0),section_xy(np.array([0.]),0))))*1e3:.3f} mm (requested 22)')
print(f'max section thickness: {normal_thickness.max()*1e3:.4f} mm = {100*normal_thickness.max()/CHORD:.3f}% chord (requested 6%)')
print(f'assumed NACA camber: {100*CAMBER:.1f}% at {100*CAMBER_POS:.0f}% chord')
# -- output
