# -- cell 13 (240.0s, exit 0)
import sys
sys.path.insert(0,'.reference')
from cad_export import export_patches
CAVITY_X=0.160; CAVITY_Y=0.140; CAVITY_Z=0.120
cavity=bd.Box(CAVITY_X,CAVITY_Y,CAVITY_Z)
fluid=cavity-pinion_solid-wheel_solid
faces=list(fluid.faces())
# Map each resulting face to the source that generated it. Cylinders of the assumed
# shaft radius are named as bores first; box-source faces are cavity walls.
pin_bore=[]; wheel_bore=[]; walls=[]; pinion_faces=[]; wheel_faces=[]
for f in faces:
    gt=str(f.geom_type)
    if 'CYLINDER' in gt and abs(f.radius-SHAFT_RADIUS)<1e-7:
        ax=f.axis_of_rotation.direction
        if abs(ax.X)>0.9: pin_bore.append(f)
        elif abs(ax.Z)>0.9: wheel_bore.append(f)
    elif min(f.distance_to(cf) for cf in cavity.faces())<1e-8:
        walls.append(f)
    elif f.distance_to(pinion_solid)<1e-8:
        pinion_faces.append(f)
    elif f.distance_to(wheel_solid)<1e-8:
        wheel_faces.append(f)
    else:
        print('UNCLASSIFIED',f.geom_type,f.area,f.center())
print('fluid volume L:',fluid.volume*1000,'connected solids:',len(fluid.solids()))
print('patch face counts:',{'pinion':len(pinion_faces),'wheel':len(wheel_faces),'cavity_walls':len(walls),'pinion_shaft_bore':len(pin_bore),'wheel_shaft_bore':len(wheel_bore)},'total',len(faces))
os.makedirs('constant/triSurface',exist_ok=True)
export_patches(fluid,{'pinion':pinion_faces,'wheel':wheel_faces,'cavity_walls':walls,'pinion_shaft_bore':pin_bore,'wheel_shaft_bore':wheel_bore},tolerance=2.5e-4,directory='constant/triSurface')
