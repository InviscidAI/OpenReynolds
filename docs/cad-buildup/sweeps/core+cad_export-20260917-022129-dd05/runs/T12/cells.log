# -- cell 2 (0.3s, exit 1)
from build123d import *
# All dimensions are metres.
R_BACK=0.060; T_BACK=0.004; R_HUB=0.012; HUB_RISE=0.018
Z_FLOOR=T_BACK; PASSAGE_H=0.014; Z_SHROUD=Z_FLOOR+PASSAGE_H
R_BLADE_IN=0.016; R_OUT=0.058; BLADE_T=0.003; N_BLADES=7; SWEEP_DEG=30.0
# Smooth polar centreline, with zero endpoint second derivative in the angular progression.
u=np.linspace(0,1,31); r=R_BLADE_IN+(R_OUT-R_BLADE_IN)*u
theta=-math.radians(SWEEP_DEG)*(3*u**2-2*u**3)
pts=[(float(ri*math.cos(ti)),float(ri*math.sin(ti))) for ri,ti in zip(r,theta)]
centre=Spline(*pts)
blade_sketch=offset(centre, amount=BLADE_T/2, side=Side.BOTH, closed=True)
blade0=extrude(blade_sketch, amount=PASSAGE_H, dir=(0,0,1)).located(Location((0,0,Z_FLOOR)))
blades=Compound([Rot(0,0,k*360/N_BLADES)*blade0 for k in range(N_BLADES)])
envelope=(Cylinder(R_OUT,PASSAGE_H)-Cylinder(R_HUB,PASSAGE_H)).located(Location((0,0,Z_FLOOR)))
fluid=envelope-blades
print('fluid solids',len(fluid.solids()),'volume m3',fluid.volume)
print('requested/measured passage height',PASSAGE_H,fluid.bounding_box().size.Z)
print('requested/measured blade thickness',BLADE_T,blade_sketch.bounding_box().size.Y) # local approximate, not true normal
print('requested/measured sweep deg',SWEEP_DEG,math.degrees(theta[0]-theta[-1]))
print('requested/measured blade count',N_BLADES,len(blades.solids()))
print('extent',fluid.bounding_box().min,fluid.bounding_box().max)
