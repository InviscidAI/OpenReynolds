tol=2e-5
inlet=[]; shroud=[]; backplate=[]; hub=[]; outlet=[]; blade_surfaces=[]
for f in faces:
    c=f.center(); n=f.normal_at(c)
    rr=math.hypot(c.X,c.Y)
    if abs(c.Z-Z_SHROUD)<tol and n.Z>0.5:
        (inlet if rr < R_BLADE_IN+tol else shroud).append(f)
    elif abs(c.Z-Z_FLOOR)<tol and n.Z < -0.5: backplate.append(f)
    elif abs(rr-R_HUB)<tol: hub.append(f)
    elif abs(rr-R_OUT)<tol: outlet.append(f)
    else: blade_surfaces.append(f)
print('face groups', {k:len(v) for k,v in {'inlet':inlet,'outlet':outlet,'blades':blade_surfaces,'backplate':backplate,'hub':hub,'shroud':shroud}.items()},'total',len(faces))
