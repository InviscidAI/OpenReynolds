import numpy as np
for i,f in enumerate(oil.faces()):
    c = f.center()
    print(i, f.geom_type, "area=%.6e"%f.area, "c=(%.4f,%.4f,%.4f)"%(c.X,c.Y,c.Z),
          "r_at_pt=%.4f"%np.hypot(*f.center_location.position.to_tuple()[:2]),
          "normal=", f.normal_at(f.center() if f.geom_type==GeomType.PLANE else None))
