    p = gmsh.model.addPhysicalGroup(2, tags); gmsh.model.setPhysicalName(2, p, NAME[g])
pv = gmsh.model.addPhysicalGroup(3, [1]); gmsh.model.setPhysicalName(3, pv, "internal")
gmsh.option.setNumber("Mesh.MshFileVersion", 2.2)
