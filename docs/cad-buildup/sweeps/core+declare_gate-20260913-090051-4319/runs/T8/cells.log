import numpy as np, re
def bbox(reg):
    t=open(f"constant/{reg}/polyMesh/points").read()
    pts=np.array(re.findall(r"\(([-\d.e ]+)\)",t.split("(",1)[1]),dtype=object)
    P=np.array([list(map(float,s.split())) for s in pts])
    return P.min(0),P.max(0),len(P)
for reg in ["fluid","solid"]:
    lo,hi,n=bbox(reg); print(reg,"min",lo,"max",hi,"size(mm)",(hi-lo)*1000)
print("interface area mm^2 =", 48*5*5, " expected", 40*30)
