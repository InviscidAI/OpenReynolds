# -- cell 2 (0.1s, exit 0)
def fx(i,k0,k1): return [V(i,0,k0),V(i,1,k0),V(i,1,k1),V(i,0,k1)]
def fy(j,i0,i1,k0,k1): return [V(i0,j,k0),V(i1,j,k0),V(i1,j,k1),V(i0,j,k1)]
def fz(k,i0,i1): return [V(i0,0,k),V(i1,0,k),V(i1,1,k),V(i0,1,k)]

patches = {
 "inlet":  ("patch", [fx(0,1,2)]),
 "outlet": ("patch", [fx(3,1,2)]),
 "duct_walls": ("wall",
    [fz(2,0,1),fz(2,1,2),fz(2,2,3)]                       # ceiling
  + [fz(1,0,1),fz(1,2,3)]                                  # floor either side of block
  + [fy(0,i,i+1,1,2) for i in range(3)]                    # side y=0
  + [fy(1,i,i+1,1,2) for i in range(3)]),                  # side y=30mm
 "solid_walls": ("wall",
    [fz(0,1,2)]                                            # block bottom
  + [fx(1,0,1), fx(2,0,1)]                                 # block ends
  + [fy(0,1,2,0,1), fy(1,1,2,0,1)]),                       # block sides
}
def blk(name,typ,faces):
    s=f"    {name}\n    {{\n        type {typ};\n        faces\n        (\n"
    for f in faces: s+= "            ("+" ".join(map(str,f))+")\n"
    return s+"        );\n    }\n"

dictstr = ("FoamFile{version 2.0; format ascii; class dictionary; object blockMeshDict;}\n"
 "scale 1;\n\nvertices\n(\n" + "".join(f"    ({x} {y} {z})\n" for x,y,z in verts) + ");\n\n"
 "blocks\n(\n" + "\n".join(blocks) + "\n);\n\nedges();\n\nboundary\n(\n"
 + "".join(blk(n,t,f) for n,(t,f) in patches.items()) + ");\n\nmergePatchPairs();\n")
open("system/blockMeshDict","w").write(dictstr)
print(len(verts), sum(len(f) for _,f in patches.values()))
# -- output
