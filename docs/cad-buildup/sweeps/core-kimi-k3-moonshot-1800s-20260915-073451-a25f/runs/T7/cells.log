import pyvista as pv
pv.set_jupyter_backend("static")

mesh = pv.read("VTK/t7_0/internal.vtu")
print("arrays:", mesh.array_names)
print("cellZoneID values:", set(mesh.cell_data["cellZoneID"]) if "cellZoneID" in mesh.cell_data else "none")

import numpy as np
zid = mesh.cell_data["cellZoneID"]
mesh.cell_data["zone"] = zid

# Cut the mesh at mid-height-ish plane and show a slice + zone volumes
sl = mesh.slice(normal=(0,1,0), origin=(0.05, 0.03, 0.02))

heater = mesh.threshold([0.5, 1.5], scalars="zone")  # whichever id
cooler = mesh.threshold([1.5, 2.5], scalars="zone")

pl = pv.Plotter(off_screen=True, window_size=(900, 600))
pl.add_mesh(sl, color="lightgrey", opacity=0.35, show_edges=False)
pl.add_mesh(heater, color="red", show_edges=True, label="heater zone")
pl.add_mesh(cooler, color="blue", show_edges=True, label="cooler zone")
pl.add_legend()
pl.add_axes()
pl.camera_position = 'iso'
pl.show()
