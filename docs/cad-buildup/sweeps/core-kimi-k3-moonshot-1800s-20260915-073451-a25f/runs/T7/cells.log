# -- cell 11 (0.4s, exit 0)
import numpy as np
centers = mesh.cell_centers().points

def in_box(c, lo, hi):
    return np.all((c >= lo) & (c <= hi), axis=1)

zone = np.zeros(mesh.n_cells, dtype=int)
zone[in_box(centers, HEATER_BOX[0:1]*1 + (HEATER_Y[0], HEATER_Z[0]), (HEATER_BOX[1], HEATER_Y[1], HEATER_Z[1]))] = 1
zone[in_box(centers, (COOLER_BOX[0], COOLER_Y[0], COOLER_Z[0]), (COOLER_BOX[1], COOLER_Y[1], COOLER_Z[1]))] = 2
mesh.cell_data["zone"] = zone
print("heater cells:", (zone==1).sum(), "cooler cells:", (zone==2).sum())

sl = mesh.slice(normal=(0,1,0), origin=(0.05, 0.03, 0.02))
heater_m = mesh.threshold([0.5, 1.5], scalars="zone")
cooler_m = mesh.threshold([1.5, 2.5], scalars="zone")

pl = pv.Plotter(off_screen=True, window_size=(900, 600))
pl.add_mesh(sl, color="lightgrey", opacity=0.3)
pl.add_mesh(heater_m, color="red", show_edges=True, label="heater (on floor, x- end)")
pl.add_mesh(cooler_m, color="blue", show_edges=True, label="cooler (on ceiling, x+ end)")
pl.add_legend()
pl.add_axes()
pl.camera_position = 'iso'
pl.show()
