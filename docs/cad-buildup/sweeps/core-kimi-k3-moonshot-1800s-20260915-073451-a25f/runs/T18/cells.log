# -- cell 4 (0.2s, exit 1)
faces = cyl.faces()
groups = {"barrel": [], "fins": [], "head": []}
import math
for f in faces:
    gt = f.geom_type
    bb = f.bounding_box()
    if gt == "SPHERE":
        groups["head"].append(f)
    elif gt == "CYLINDER":
        d = bb.max.x - bb.min.x   # diameter of the cylindrical face
        if abs(d - 2*R_BARREL) < 1e-6:
            groups["barrel"].append(f)
        else:
            groups["fins"].append(f)
    elif gt == "PLANE":
        # fin annulus area ~ pi(0.07^2-0.045^2)=9.19e-3 ; barrel bottom disk ~ pi*0.045^2=6.36e-3
        if f.area > 8e-3:
            groups["fins"].append(f)
        else:
            groups["barrel"].append(f)
    else:
        print("unclassified:", gt, f.area)

for k, v in groups.items():
    print(k, len(v), "faces, total area %.6f m^2" % sum(f.area for f in v))

# ---- measurements against the request ----
fin_out = [f for f in groups["fins"] if f.geom_type=="CYLINDER"]
fin_flat = [f for f in groups["fins"] if f.geom_type=="PLANE"]
zs_bot = sorted(round(f.center().z, 9) for f in fin_flat if f.center().z < 0)  # annuli below fin mid-height? no
print("\nfin outer face diameter:", fin_out[0].bounding_box().max.x*2*2/2, "-> OD m:", fin_out[0].bounding_box().max.x - fin_out[0].bounding_box().min.x)
# fin thickness & gap from annulus z positions
z_ann = sorted(round(f.center().z, 9) for f in fin_flat)
print("n annuli:", len(z_ann))
thick = [z_ann[2*i+1]-z_ann[2*i] for i in range(N_FINS)]
gaps  = [z_ann[2*i+2]-z_ann[2*i+1] for i in range(N_FINS-1)]
print("fin thicknesses min/max: %.6f %.6f" % (min(thick), max(thick)))
print("gaps min/max: %.6f %.6f" % (min(gaps), max(gaps)))
print("n fins (outer cyl faces):", len(fin_out))
bar_cyl = [f for f in groups["barrel"] if f.geom_type=="CYLINDER"]
print("barrel OD:", bar_cyl[0].bounding_box().max.x*2)
print("head sphere diameter:", groups["head"][0].bounding_box().max.x*2, "dome top z:", groups["head"][0].bounding_box().max.z)
print("barrel+head z extent: 0 ->", cyl.bounding_box().max.z)
