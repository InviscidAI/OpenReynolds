import numpy as np
import build123d as bd

# --- parameters (metres) ---
L = 0.900                      # duct length, axis = z, z=0 fan exit, z=L nozzle
Z_STATIONS = [0.0, L/2, L]
R_OUT = [0.450, 0.430, 0.410]  # outer cowl inner surface
R_CORE = [0.280, 0.310, 0.250] # core cowl outer surface

# smooth blends: quadratic through the three stations (outer one is linear, a degenerate quadratic)
co_out  = np.polyfit(Z_STATIONS, R_OUT, 2)
co_core = np.polyfit(Z_STATIONS, R_CORE, 2)
r_out  = lambda z: np.polyval(co_out, z)
r_core = lambda z: np.polyval(co_core, z)
print("outer poly coeffs:", co_out, " core poly coeffs:", co_core)

def revolved_solid(rfun, name):
    """Solid of revolution about z: region 0<=r<=rfun(z), 0<=z<=L."""
    zs = np.linspace(0, L, 25)
    prof = [bd.Vector(rfun(z), 0, z) for z in zs]          # outer profile curve
    wire = bd.Wire.make_wire([
        bd.Spline(prof),                                   # profile (exact-ish, interpolating)
        bd.Line(prof[-1], bd.Vector(0, 0, L)),             # top to axis
        bd.Line(bd.Vector(0, 0, L), bd.Vector(0, 0, 0)),   # down the axis
        bd.Line(bd.Vector(0, 0, 0), prof[0]),              # axis back out
    ])
    face = bd.Face.make_from_wires(wire)
    return bd.revolve(face, axis=bd.Axis.Z, revolution_arc=360)

outer_solid = revolved_solid(r_out, "outer")
core_solid  = revolved_solid(r_core, "core")
fluid = outer_solid - core_solid
print("fluid volume: %.6f m^3" % fluid.volume)
# analytic volume for sanity
import scipy.integrate as si  # may not exist; fall back
