import pyvista as pv
Path('t7.foam').touch()
reader = pv.OpenFOAMReader('t7.foam')
reader.set_active_time_value(0.0)
mesh_data = reader.read()
print(mesh_data)
print('Blocks:', list(mesh_data.keys()) if hasattr(mesh_data, 'keys') else 'single dataset')
