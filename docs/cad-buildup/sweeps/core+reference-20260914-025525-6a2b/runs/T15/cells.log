# -- cell 14 (240.0s, exit 0)
EPS = 0.02
groups = {k: [] for k in ["pinion","wheel","walls","pinion_bore","wheel_bore"]}
unk = 0
for f in fluid.faces():
    p = f.position_at(0.5, 0.5)
    n = f.normal_at(p)
    qa, qb = p - n*EPS, p + n*EPS
    qin = qa if fluid.is_inside(qa) else qb          # point just inside the oil
    qout = qb if fluid.is_inside(qa) else qa         # point just outside, in the solid
    if pinion.is_inside(qout):   g = "pinion"
    elif wheel.is_inside(qout):  g = "wheel"
    elif pass1.is_inside(qin):   g = "pinion_bore"
    elif pass2.is_inside(qin):   g = "wheel_bore"
    else:                        g = "walls"
    groups[g].append(f)
for k, v in groups.items():
    a = sum(f.area for f in v)
    print("%-12s %4d faces, area %9.1f mm^2" % (k, len(v), a))
