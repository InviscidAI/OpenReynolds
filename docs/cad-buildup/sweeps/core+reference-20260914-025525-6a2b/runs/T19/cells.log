import subprocess
os.makedirs("constant/triSurface", exist_ok=True)
fl = fluid.faces()
patches = {"bore": [fl[0]], "shaft": [fl[3]], "keywayFloor": [fl[5]],
           "keywayFlanks": [fl[4], fl[6]], "highPressure": [fl[2]], "lowPressure": [fl[1]]}
MM = 0.001  # mm -> m, applied once, here
for name, faces in patches.items():
    shell = bd.Shell([f.scale(MM) for f in faces])
    bd.export_stl(shell, f"constant/triSurface/{name}.stl", tolerance=1e-6, angular_tolerance=0.02)
print(subprocess.run(["ls","-l","constant/triSurface"],capture_output=True,text=True).stdout)
