# -- cell 5 (2.7s, exit 0)
R_SPLIT = R_LE   # 16 mm: shroud covers the bladed annulus, inside it is the axial inlet opening
ring = lambda ro, ri: bd.extrude(bd.make_face(bd.Circle(ro).wire()) - bd.make_face(bd.Circle(ri).wire()), H_BLADE)
