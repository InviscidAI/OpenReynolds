# -- cell 2 (288.7s, exit 0)
import build123d as bd, os
D = 0.040          # sphere diameter (given)
R = D/2
UP, DOWN, SIDE = 5*D, 15*D, 5*D   # given: 5D up, 15D down, 5D sides/top/bottom
sphere = bd.Sphere(radius=R)
print("bbox", sphere.bounding_box(), "vol", sphere.volume, "exact", 4/3*3.141592653589793*R**3)
os.makedirs("constant/triSurface", exist_ok=True)
bd.export_stl(sphere, "constant/triSurface/sphere.stl", tolerance=1e-5, angular_tolerance=0.1)
print(os.path.getsize("constant/triSurface/sphere.stl"))
