# -- cell 16 (1.8s, exit 0)
PITCH_DEG = 360.0/N_BLADE
prof = bd.Plane.XZ * bd.Rectangle(X_OUT-X_IN, R_TIP-R_HUB)   # placeholder plane, fix below
prof = bd.Face(bd.Wire(bd.Polyline([Vector(X_IN,R_HUB,0),Vector(X_OUT,R_HUB,0),
                                    Vector(X_OUT,R_TIP,0),Vector(X_IN,R_TIP,0),Vector(X_IN,R_HUB,0)])))
sector = bd.revolve(prof, axis=Axis.X, revolution_arc=PITCH_DEG)
print("sector vol", round(sector.volume,1), "expected",
      round(math.radians(PITCH_DEG)/2*(R_TIP**2-R_HUB**2)*(X_OUT-X_IN),1), "faces", len(sector.faces()))
bladeA = blade
bladeB = blade.rotate(Axis.X, PITCH_DEG)
fluid = sector - bladeA - bladeB
print("fluid vol", round(fluid.volume,1), "valid", fluid.is_valid, "solids", len(fluid.solids()), "faces", len(fluid.faces()))
# -- output
sector vol 42977.5 expected 42977.5 faces 6
fluid vol 42086.1 valid True solids 1 faces 987

# -- cell 17 (240.0s, exit 0)
groups = {k: [] for k in ["hub","shroud","inlet","outlet","periodic_1","periodic_2",
                          "blade_suction","blade_pressure"]}
tol = 1e-6
for fc in fluid.faces():
    c = fc.center()
    r = math.hypot(c.Y, c.Z); th = math.degrees(math.atan2(c.Z, c.Y))
    n = fc.normal_at(c)
    if abs(n.X) > 0.999 and abs(c.X - X_IN) < 1e-6:      groups["inlet"].append(fc)
    elif abs(n.X) > 0.999 and abs(c.X - X_OUT) < 1e-6:   groups["outlet"].append(fc)
    elif abs(r-R_HUB) < 1e-6 and abs(n.X) < 1e-6:        groups["hub"].append(fc)
    elif abs(r-R_TIP) < 1e-6 and abs(n.X) < 1e-6:        groups["shroud"].append(fc)
    elif abs(th) < 1e-6:                                  groups["periodic_1"].append(fc)
    elif abs(th-PITCH_DEG) < 1e-6:                        groups["periodic_2"].append(fc)
    else:
        dA = bd.Shape.distance_to(fc, bladeA); dB = bd.Shape.distance_to(fc, bladeB)
        groups["blade_suction" if dA < dB else "blade_pressure"].append(fc)
tot = 0
for k,v in groups.items():
    a = sum(f.area for f in v); tot += len(v)
    print(f"{k:15s} nfaces {len(v):4d}  area {a:9.2f} mm^2")
print("classified", tot, "of", len(fluid.faces()))
