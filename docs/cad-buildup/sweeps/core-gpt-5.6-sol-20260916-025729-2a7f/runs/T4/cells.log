# -- cell 5 (0.8s, exit 1)
import pathlib, subprocess, textwrap
pathlib.Path("system").mkdir(exist_ok=True)
pathlib.Path("constant").mkdir(exist_ok=True)
gmsh.initialize()
gmsh.option.setNumber("General.Terminal", 1)
gmsh.model.add("cold_plate_water")
gmsh.model.occ.importShapes("fluid_volume.step")
gmsh.model.occ.synchronize()
surf_tags=[t for d,t in gmsh.model.getEntities(2)]
def near(a,b,tol=1e-8): return abs(a-b)<tol
inlet=[]; outlet=[]
for t in surf_tags:
    x,y,z=gmsh.model.occ.getCenterOfMass(2,t); a=gmsh.model.occ.getMass(2,t)
    if near(x,-PLATE_L/2) and near(y,-PITCH) and near(a,CHANNEL_W*CHANNEL_D): inlet.append(t)
    if near(x, PLATE_L/2) and near(y, PITCH) and near(a,CHANNEL_W*CHANNEL_D): outlet.append(t)
assert len(inlet)==1 and len(outlet)==1, (inlet,outlet)
walls=[t for t in surf_tags if t not in inlet+outlet]
for tags,name in [(inlet,"inlet"),(outlet,"outlet"),(walls,"walls")]:
    pg=gmsh.model.addPhysicalGroup(2,tags); gmsh.model.setPhysicalName(2,pg,name)
vol_tags=[t for d,t in gmsh.model.getEntities(3)]
pg=gmsh.model.addPhysicalGroup(3,vol_tags); gmsh.model.setPhysicalName(3,pg,"fluid")
gmsh.option.setNumber("Mesh.MeshSizeMin",0.001)
gmsh.option.setNumber("Mesh.MeshSizeMax",0.001)
gmsh.option.setNumber("Mesh.Algorithm3D",1)
gmsh.model.mesh.generate(3)
gmsh.option.setNumber("Mesh.MshFileVersion",2.2)
gmsh.write("cold_plate_water.msh")
print("Tagged inlet/outlet/wall CAD faces:",len(inlet),len(outlet),len(walls))
print("Gmsh nodes/elements:",len(gmsh.model.mesh.getNodes()[0]),sum(len(e[1]) for e in [gmsh.model.mesh.getElements()[1]]))
gmsh.finalize()
res=subprocess.run(["gmshToFoam","cold_plate_water.msh"],text=True,capture_output=True)
print(res.stdout[-2500:]); print(res.stderr[-1000:])
if res.returncode: raise RuntimeError(f"gmshToFoam failed {res.returncode}")
