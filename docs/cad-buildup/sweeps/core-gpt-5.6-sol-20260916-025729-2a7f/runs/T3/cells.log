def set_patch_type(text,name,newtype):
    pat=r'(\n\s*'+re.escape(name)+r'\s*\n\s*\{.*?\n\s*type\s+)\w+(;.*?\n\s*physicalType\s+)\w+(;)'
    return re.sub(pat,lambda m:m.group(1)+newtype+m.group(2)+newtype+m.group(3),text,count=1,flags=re.S)
