# -- cell 3 (0.1s, exit 0)
from IPython.display import display
print('cut signature:',inspect.signature(core_box.cut))
honeycomb=core_box.cut(*openings)
full_vol=CORE_L*DUCT*DUCT
wall_fraction=honeycomb.volume/full_vol
print(f'full slab={full_vol:.9g} m3, honeycomb walls={honeycomb.volume:.9g} m3, solid fraction={wall_fraction:.4f}')
print(f'requested clear AF={CELL_AF/MM:.3f} mm; measured from vertices={np.sqrt(3)*R_OPEN/MM:.3f} mm')
print(f'requested wall={WALL/MM:.3f} mm; measured pitch-clear={PITCH_AF/MM-CELL_AF/MM:.3f} mm')
