# -- cell 2 (0.4s, exit 0)
R_OPEN=CELL_AF/np.sqrt(3); R_PITCH=PITCH_AF/np.sqrt(3)
dy=1.5*R_PITCH; dz=PITCH_AF
centers=[]
for i in range(-7,8):
    for j in range(-7,8):
        y=i*dy; z=(j+0.5*(i&1))*dz
        if abs(y) < DUCT/2+R_OPEN and abs(z) < DUCT/2+R_OPEN:
            centers.append((y,z))
hex_pts=lambda y,z: [(0,y+R_OPEN*np.cos(k*np.pi/3),z+R_OPEN*np.sin(k*np.pi/3)) for k in range(6)]
openings=[bd.extrude(bd.Face(bd.Polygon(*hex_pts(y,z))), amount=CORE_L, dir=(1,0,0)) for y,z in centers]
core_box=bd.Pos(CORE_L/2,0,0)*bd.Box(CORE_L,DUCT,DUCT)
honeycomb=core_box-bd.Compound(openings)
print('cells laid out:',len(centers),'solid volume m3:',honeycomb.volume,'bbox:',honeycomb.bounding_box().size)
fig,ax=plt.subplots(figsize=(6,6)); ax.add_patch(plt.Rectangle((-DUCT/2/MM,-DUCT/2/MM),DUCT/MM,DUCT/MM,fill=False,lw=2))
for y,z in centers:
 p=np.array([(y+R_OPEN*np.cos(k*np.pi/3),z+R_OPEN*np.sin(k*np.pi/3)) for k in range(6)])/MM
 ax.fill(p[:,0],p[:,1],facecolor='white',edgecolor='tab:blue',lw=.8)
ax.set_aspect('equal'); ax.set_xlabel('y [mm]'); ax.set_ylabel('z [mm]'); ax.set_title('Honeycomb clear openings (coarse geometry check)'); ax.grid(True,alpha=.2)
display(fig)
# -- output
