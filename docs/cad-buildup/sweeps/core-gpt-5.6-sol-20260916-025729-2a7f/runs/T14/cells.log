import matplotlib.pyplot as plt
# Requested dimensions, metres
C_ROOT, C_TIP, SPAN = 0.120, 0.080, 0.200
XMIN, XMAX = -4*C_ROOT, C_ROOT + 8*C_ROOT
YMIN, YMAX = -3*C_ROOT, 3*C_ROOT
ZMIN, ZMAX = 0.0, SPAN + 3*C_ROOT

def naca2412_points(chord, z, n=81):
    beta=np.linspace(0,np.pi,n); xc=(1-np.cos(beta))/2
    m,p,t=0.02,0.4,0.12
    yt=5*t*(0.2969*np.sqrt(xc)-0.1260*xc-0.3516*xc**2+0.2843*xc**3-0.1036*xc**4)
    yc=np.where(xc<p,m/p**2*(2*p*xc-xc**2),m/(1-p)**2*((1-2*p)+2*p*xc-xc**2))
    dy=np.where(xc<p,2*m/p**2*(p-xc),2*m/(1-p)**2*(p-xc)); th=np.arctan(dy)
    xu=(xc-yt*np.sin(th))*chord; yu=(yc+yt*np.cos(th))*chord
    xl=(xc+yt*np.sin(th))*chord; yl=(yc-yt*np.cos(th))*chord
    # TE upper -> LE -> TE lower, omit duplicate LE and close explicitly
    xy=np.vstack([np.c_[xu[::-1],yu[::-1]],np.c_[xl[1:],yl[1:]]])
    return [(float(x),float(y),float(z)) for x,y in xy]
root_pts=naca2412_points(C_ROOT,0); tip_pts=naca2412_points(C_TIP,SPAN)
root_wire=bd.Wire.make_polygon(root_pts, close=True)
tip_wire=bd.Wire.make_polygon(tip_pts, close=True)
wing=bd.loft([root_wire,tip_wire], ruled=False)
domain=bd.Box(XMAX-XMIN,YMAX-YMIN,ZMAX-ZMIN).moved(bd.Location((XMIN,YMIN,ZMIN)))
fluid=domain-wing
bb=wing.bounding_box()
print(f'root chord measured endpoints: {C_ROOT:.6f} m (requested 0.120000)')
print(f'tip chord measured endpoints:  {C_TIP:.6f} m (requested 0.080000)')
print(f'span measured:                 {bb.max.Z-bb.min.Z:.6f} m (requested 0.200000)')
print(f'leading-edge sweep offset:     {tip_pts[80][0]-root_pts[80][0]:.6g} m (requested no sweep)')
print(f'root max profile thickness:    {max(y for x,y,z in root_pts)-min(y for x,y,z in root_pts):.6f} m (NACA 12% nominal 0.014400)')
print(f'domain x=[{XMIN:.3f},{XMAX:.3f}], y=[{YMIN:.3f},{YMAX:.3f}], z=[{ZMIN:.3f},{ZMAX:.3f}] m')
# 3D surface preview from profile stations
from mpl_toolkits.mplot3d import Axes3D
r=np.array(root_pts); t=np.array(tip_pts)
fig=plt.figure(figsize=(9,5)); ax=fig.add_subplot(111,projection='3d')
for a,b in zip(r,t): ax.plot([a[0],b[0]],[a[2],b[2]],[a[1],b[1]],color='steelblue',alpha=.18)
ax.plot(r[:,0],r[:,2],r[:,1],'k'); ax.plot(t[:,0],t[:,2],t[:,1],'k')
