# -- cell 2 (0.4s, exit 1)
from build123d import Box, Cylinder, Circle, Plane, Pos, Vector, Line, CenterArc, Wire, sweep, Axis, Align
L, W, H = 0.300, 0.120, 0.080
D_THROTTLE, D_RUNNER, R_BEND = 0.070, 0.038, 0.060
STRAIGHT = 0.030
X_STATIONS = [-0.1125, -0.0375, 0.0375, 0.1125]
# Plenum spans x=[-L/2,L/2], y=[-W/2,W/2], z=[0,H].
plenum = Pos(-L/2, -W/2, 0) * Box(L, W, H)
runners = []
runner_paths = []
for side in (-1, 1):
    y0 = side*W/2
    for x in X_STATIONS:
        p0 = Vector(x, y0-side*0.002, H/2)
        p1 = Vector(x, y0+side*STRAIGHT, H/2)
        c = Vector(x, y0+side*STRAIGHT, H/2-R_BEND)
        line = Line(p0, p1)
        # Arc starts at top of its circle and turns outboard/downward.
        arc = CenterArc(c, R_BEND, 90, -side*90 if side == -1 else 90)
        # Correct explicit paths below, avoiding angle convention ambiguity.
        if side == 1:
            arc = CenterArc(c, R_BEND, 90, -90)
        else:
            arc = CenterArc(c, R_BEND, 90, 90)
        path = Wire([line, arc])
        section = Plane(origin=p0, x_dir=(1,0,0), z_dir=(0,side,0)) * Circle(D_RUNNER/2)
        tube = sweep(section, path, is_frenet=True)
        runners.append(tube)
        runner_paths.append(path)
fluid = plenum
for tube in runners:
    fluid = fluid + tube
fluid = fluid.clean()
print('solids', len(fluid.solids()), 'faces', len(fluid.faces()), 'volume m3', fluid.volume)
print('bounds', fluid.bounding_box().min, fluid.bounding_box().max)
print('stations requested/equal pitch:', X_STATIONS, np.diff(X_STATIONS))
