# -- cell 26 (6.1s, exit 0)
master=pv.read('fluidUnionTest.stl').triangulate(); cc=master.cell_centers().points
P=master.points; F=master.faces.reshape(-1,4)[:,1:]
labels=np.empty(master.n_cells,dtype=object)
for i,(cen,ids) in enumerate(zip(cc,F)):
    verts=P[ids]; x,y,z=cen
    onwall=(np.ptp(verts[:,0])<2e-7 and (abs(x-Lx/2)<2e-7 or abs(x+Lx/2)<2e-7)) or (np.ptp(verts[:,1])<2e-7 and (abs(y-Ly/2)<2e-7 or abs(y+Ly/2)<2e-7)) or (np.ptp(verts[:,2])<2e-7 and (abs(z-Lz/2)<2e-7 or abs(z+Lz/2)<2e-7))
    if onwall: lab='cavityWalls'
    elif x>=pin_zo-2e-5 and x<=Lx/2+2e-5 and abs(math.hypot(y,z)-shaft_r)<4e-4: lab='pinionShaftBore'
    elif z>=w_zo-2e-5 and z<=Lz/2+2e-5 and abs(math.hypot(x,y)-shaft_r)<4e-4: lab='wheelShaftBore'
    else:
        pin_ax=pin_zi-2e-5<=x<=pin_zo+2e-5; wh_ax=w_zi-2e-5<=z<=w_zo+2e-5
        if pin_ax and not wh_ax: lab='pinion'
        elif wh_ax and not pin_ax: lab='wheel'
        elif pin_ax and wh_ax: lab='pinion' if abs((x-(pin_zi+pin_zo)/2)/(pin_zo-pin_zi)) > abs((z-(w_zi+w_zo)/2)/(w_zo-w_zi)) else 'wheel'
        else: raise RuntimeError(('unclassified triangle',i,cen))
    labels[i]=lab
for name in groups:
    ids=np.where(labels==name)[0]; master.extract_cells(ids).extract_surface().triangulate().save(f'{tri}/{name}.stl',binary=True)
print({n:int(np.sum(labels==n)) for n in groups},'total',master.n_cells)
