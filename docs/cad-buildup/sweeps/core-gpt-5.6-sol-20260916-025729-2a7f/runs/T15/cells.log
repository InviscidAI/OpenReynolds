# -- cell 9 (0.4s, exit 0)
groups={'cavityWalls':[],'pinion':[],'wheel':[],'pinionShaftBore':[],'wheelShaftBore':[]}
amb=[]
tol=2e-6
for f in fluid.faces():
    bb=f.bounding_box(); c=f.center(); gt=str(f.geom_type)
    onwall=(abs(bb.min.X+Lx/2)<tol and abs(bb.max.X+Lx/2)<tol) or (abs(bb.min.X-Lx/2)<tol and abs(bb.max.X-Lx/2)<tol) or (abs(bb.min.Y+Ly/2)<tol and abs(bb.max.Y+Ly/2)<tol) or (abs(bb.min.Y-Ly/2)<tol and abs(bb.max.Y-Ly/2)<tol) or (abs(bb.min.Z+Lz/2)<tol and abs(bb.max.Z+Lz/2)<tol) or (abs(bb.min.Z-Lz/2)<tol and abs(bb.max.Z-Lz/2)<tol)
    if onwall: groups['cavityWalls'].append(f)
    elif 'CYLINDER' in gt:
        # Pinion shaft cylinders vary principally in X; wheel shaft cylinders in Z
        if (bb.max.X-bb.min.X) > (bb.max.Z-bb.min.Z): groups['pinionShaftBore'].append(f)
        else: groups['wheelShaftBore'].append(f)
    else:
        pin_ax=(bb.min.X>=pin_zi-1e-5 and bb.max.X<=pin_zo+1e-5)
        wh_ax=(bb.min.Z>=w_zi-1e-5 and bb.max.Z<=w_zo+1e-5)
        if pin_ax and not wh_ax: groups['pinion'].append(f)
        elif wh_ax and not pin_ax: groups['wheel'].append(f)
        elif pin_ax and wh_ax:
            # contact-zone cut faces: assign by which axial span they occupy more tightly
            sx=(bb.max.X-bb.min.X)/(pin_zo-pin_zi); sz=(bb.max.Z-bb.min.Z)/(w_zo-w_zi)
            groups['pinion' if sx>sz else 'wheel'].append(f)
        else: amb.append((gt,tuple(c),bb.min,bb.max,f.area))
print({k:(len(v),sum(f.area for f in v)) for k,v in groups.items()})
print('ambiguous',len(amb)); print(amb[:10])
