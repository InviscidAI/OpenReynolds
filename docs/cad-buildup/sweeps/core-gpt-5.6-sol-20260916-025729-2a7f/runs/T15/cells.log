ivals=[]
for deg in phases:
    w=Rot(0,0,float(deg))*wheel0
    try: ivals.append((deg,(pinion&w).volume))
    except: ivals.append((deg,float('nan')))
print(ivals)
best=min(ivals,key=lambda q:q[1])
wheel_phase_deg=best[0]; wheel=Rot(0,0,wheel_phase_deg)*wheel0
print('chosen wheel phase deg / common solid volume:',wheel_phase_deg,best[1])
