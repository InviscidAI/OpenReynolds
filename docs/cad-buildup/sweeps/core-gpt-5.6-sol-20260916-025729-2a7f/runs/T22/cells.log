from collections import defaultdict, deque
all_pts=[]; all_tri=[]; all_pid=[]; key_to_vid={}
for pid,name in enumerate(patch_order):
    m=pv.read(f"constant/triSurface/{name}.stl"); ff=m.faces.reshape(-1,4)[:,1:]
    local={}
    for li,p in enumerate(m.points):
        key=tuple(np.round(p.astype(float),9))
        if key not in key_to_vid: key_to_vid[key]=len(all_pts); all_pts.append(np.array(key))
        local[li]=key_to_vid[key]
    for tri in ff: all_tri.append([local[int(i)] for i in tri]); all_pid.append(pid)
all_tri=np.asarray(all_tri,int); all_pid=np.asarray(all_pid,int)
edges=defaultdict(list)
for ti,tr in enumerate(all_tri):
    for a,b in zip(tr,[tr[1],tr[2],tr[0]]): edges[tuple(sorted((a,b)))].append((ti,1 if a<b else -1))
flip=np.zeros(len(all_tri),dtype=np.int8)
for seed in range(len(all_tri)):
    if flip[seed]: continue
    flip[seed]=1; q=deque([seed])
    while q:
        t=q.popleft()
        for a,b in zip(all_tri[t],[all_tri[t,1],all_tri[t,2],all_tri[t,0]]):
            inc=edges[tuple(sorted((a,b)))]
            st=1 if a<b else -1
            for u,su in inc:
                if u==t: continue
                need=-flip[t]*st*su
                if flip[u]==0: flip[u]=need; q.append(u)
                elif flip[u]!=need: raise RuntimeError("Non-orientable or non-manifold STL union")
fixed_tri=all_tri.copy(); fixed_tri[flip<0]=fixed_tri[flip<0][:,[0,2,1]]
bad=0; free=0
chk=defaultdict(list)
for tr in fixed_tri:
    for a,b in zip(tr,[tr[1],tr[2],tr[0]]): chk[tuple(sorted((a,b)))].append(1 if a<b else -1)
for inc in chk.values():
    if len(inc)==1: free+=1
    elif len(inc)==2 and inc[0]==inc[1]: bad+=1
print("Union free edges:",free,"same-direction edges:",bad,"components seeds:",np.count_nonzero(flip==1))
pts=np.asarray(all_pts)
for pid,name in enumerate(patch_order):
    with open(f"constant/triSurface/{name}.stl","w") as f:
        f.write(f"solid {name}\n")
        for tr in fixed_tri[all_pid==pid]:
            p0,p1,p2=pts[tr]; n=np.cross(p1-p0,p2-p0); ln=np.linalg.norm(n); n=n/ln if ln else n
            f.write(f" facet normal {n[0]:.12g} {n[1]:.12g} {n[2]:.12g}\n  outer loop\n")
            for p in (p0,p1,p2): f.write(f"   vertex {p[0]:.12g} {p[1]:.12g} {p[2]:.12g}\n")
            f.write("  endloop\n endfacet\n")
        f.write(f"endsolid {name}\n")
